#!/bin/bash
# shellcheck source-path=SCRIPTDIR
#
# helios-lab — an x86 Helios (illumos) VM on AWS, for DTrace and MDB work.
#
# Manages one nested-virtualization EC2 host in ap-northeast-1 that runs one
# Helios guest under helios-engvm. `helios-lab help` lists the commands; the
# README's "Helios Lab" section covers setup and costs.
#
# Why /bin/bash and no jq: this must run on a stock Mac. Everything here is
# bash 3.2 (no associative arrays, mapfile, ${v,,}, declare -n or &>>), and
# AWS output is shaped with the CLI's own --query / --output text.
#
# Layout: this file holds config, the lock, the lab key, the orchestration of
# each command, and dispatch. Pure decisions live in lib/state.sh and
# lib/render.sh, every AWS call in lib/aws.sh, every ssh call in
# lib/remote.sh, all under ${HELIOS_LAB_HOME:-~/.local/share/helios-lab}.
# host/ is pushed to the host on every up (lib/remote.sh host_push).
#
# Exit codes (typed, so scripts and tests can tell failures apart):
#   0  ok
#   1  generic failure
#   2  usage: unknown command, bad argument or bad env value; also destroy's
#      preview without --yes, and up run without a terminal when the lab key
#      must first be created
#   3  AWS auth: missing or invalid credentials, expired SSO, permission
#      denied, root credentials
#   4  state conflict: more than one lab instance, the lab key missing or not
#      the instance's, another up/stop/destroy holding the lock
#   5  capacity: EC2 has no capacity for the type, or no zone offers it
#   6  host-key verification failure: the host offers a key its console
#      never printed, the console shows no fingerprints in time, or a pinned
#      host now offers another key. Never answered by trusting on first use.
#   8  network: AWS, checkip or the host's ssh unreachable
# `ssh` and `console` hand over to ssh once connected, so from then on the
# exit status is ssh's: the remote command's, or 255 for ssh's own failure.
#
# Env (the only knobs; region, root size and key path are constants):
#   HELIOS_LAB_PROFILE        AWS profile (default: helios-lab)
#   HELIOS_LAB_INSTANCE_TYPE  instance type, applied only at create (default: m8i.xlarge)
#   HELIOS_LAB_IDLE_MINUTES   idle minutes before the host stops itself (default: 60)
# HELIOS_LAB_STATE_DIR (state dir) is also the way out when the default one's
# path holds characters ssh's ProxyJump can't carry (up says so).
# For tests: HELIOS_LAB_HOME (library dir), HELIOS_LAB_STATE_DIR (state dir),
# HELIOS_LAB_RETRY_SECONDS (wait between attempts of every retry and poll:
# security-group delete, console fingerprints, host key, provision progress;
# default 10).
#
set -euo pipefail

readonly SELF=helios-lab
# shellcheck disable=SC2034  # the whole table lives here
readonly EX_OK=0 EX_FAIL=1 EX_USAGE=2 EX_AUTH=3 EX_CONFLICT=4 EX_CAPACITY=5 EX_HOSTKEY=6 EX_NET=8

warn() { printf '%s: %s\n' "$SELF" "$1" >&2; }

# die <code> <message> [hint...] — the code comes first, so every exit is typed
# at its call site. Hints print indented under the message.
die() {
  local code=$1 hint
  shift
  warn "$1"
  shift
  for hint in "$@"; do printf '  %s\n' "$hint" >&2; done
  exit "$code"
}

# --- Libraries ---------------------------------------------------------------
# Sourced from the yadm-deployed share dir. Tests point HELIOS_LAB_HOME at the
# repo checkout, so they exercise the working tree, not an installed copy.
readonly HELIOS_LAB_HOME="${HELIOS_LAB_HOME:-$HOME/.local/share/helios-lab}"
for lib in state aws render remote; do
  [[ -r $HELIOS_LAB_HOME/lib/$lib.sh ]] \
    || die "$EX_FAIL" "libraries not found in $HELIOS_LAB_HOME/lib" 'run yadm pull, or set HELIOS_LAB_HOME'
done
unset lib
# shellcheck source=../share/helios-lab/lib/state.sh
source "$HELIOS_LAB_HOME/lib/state.sh"
# shellcheck source=../share/helios-lab/lib/aws.sh
source "$HELIOS_LAB_HOME/lib/aws.sh"
# shellcheck source=../share/helios-lab/lib/render.sh
source "$HELIOS_LAB_HOME/lib/render.sh"
# shellcheck source=../share/helios-lab/lib/remote.sh
source "$HELIOS_LAB_HOME/lib/remote.sh"

# --- Configuration -----------------------------------------------------------
readonly PROFILE="${HELIOS_LAB_PROFILE:-helios-lab}"
readonly INSTANCE_TYPE="${HELIOS_LAB_INSTANCE_TYPE:-m8i.xlarge}"
readonly IDLE_MINUTES="${HELIOS_LAB_IDLE_MINUTES:-60}"
readonly STATE_DIR="${HELIOS_LAB_STATE_DIR:-$HOME/.local/state/helios-lab}"
# The lab key lives at one fixed path (plan: "Where state lives"), so every
# command and every Mac agrees on it. destroy never touches it.
readonly LAB_KEY="$HOME/.ssh/helios-lab_ed25519"
# Rendered on every connecting command (lib/render.sh), and the host keys
# pinned from the console: both private to this Mac, both in the state dir.
readonly SSH_CONFIG="$STATE_DIR/ssh_config" KNOWN_HOSTS="$STATE_DIR/known_hosts"
# The helios-engvm commit the guest is built from (R6), as the U7 spike ran
# it; pushed in the host config, where U3's engvm stage checks it out.
readonly ENGVM_PIN=8ef18ef53d3baa03eebe5f2238a3a4ceef1b6f4a
# destroy retries the group delete for 12 x 10 s: a terminated instance's ENI
# can hold the group for a minute or two.
readonly SG_DELETE_ATTEMPTS=12
readonly RETRY_SECONDS="${HELIOS_LAB_RETRY_SECONDS:-10}"

# validate_config — fail fast on a bad knob, before any AWS call
validate_config() {
  instance_type_ok "$INSTANCE_TYPE" || die "$EX_USAGE" \
    "HELIOS_LAB_INSTANCE_TYPE=$INSTANCE_TYPE does not support nested virtualization" \
    "use a non-metal size of one of: $(nested_virt_families)"
  idle_minutes_ok "$IDLE_MINUTES" || die "$EX_USAGE" \
    "HELIOS_LAB_IDLE_MINUTES=$IDLE_MINUTES is not a multiple of 5 between 5 and 720"
  [[ $RETRY_SECONDS =~ ^[0-9]{1,3}$ ]] || die "$EX_USAGE" \
    "HELIOS_LAB_RETRY_SECONDS=$RETRY_SECONDS is not a whole number of seconds"
}

# --- Lock and exit notice ----------------------------------------------------
# up, stop and destroy --yes hold a lock in the state dir, so one Mac never
# runs two of them at once. With discovery and the post-launch re-lookup, it
# keeps the invariant "at most one live tagged instance". macOS has no
# flock(1); shlock creates the lock with an atomic link(2) and takes over one
# whose PID is dead.
readonly SHLOCK=/usr/bin/shlock
readonly LOCK_FILE="$STATE_DIR/lock"

# lock_acquire — the traps go first, so the lock can't outlive this process
# even if a signal lands right after it is taken
lock_acquire() {
  [[ -x $SHLOCK ]] || die "$EX_FAIL" "$SHLOCK not found: helios-lab locks with macOS's shlock"
  state_dir_ensure
  trap on_exit EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  "$SHLOCK" -p "$$" -f "$LOCK_FILE" || die "$EX_CONFLICT" \
    "another helios-lab up, stop or destroy is running (pid $(cat "$LOCK_FILE" 2>/dev/null || echo unknown))" \
    'wait for it to finish; once that process is gone, the next run takes the lock over'
  rm -f "$NOTICE_FILE"   # a killed run's, whose pid this one reuses
}

# state_dir_ensure — the state dir holds the lock, the ssh fragment and the
# pinned host keys: readable by this user only
state_dir_ensure() {
  [[ -d $STATE_DIR ]] || { mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"; }
}

# lock_release — only our own lock, never another process's
lock_release() {
  if [[ $(cat "$LOCK_FILE" 2>/dev/null) == "$$" ]]; then rm -f "$LOCK_FILE"; fi
}

# on_exit [<instance-id|""> <type> <launch-epoch> <stop> <idle-minutes>] —
# the EXIT trap. Once up holds a host that may be billing (arm_notice), a
# failure or Ctrl-C prints the billing notice; then the lock goes. set +e
# because a failing command in an EXIT trap would replace the exit status.
# The stop it names is <stop>, unless this up's push has since handed the
# stop to the idle timer (notice_signal).
on_exit() {
  local rc=$? pushed
  set +e
  if (( $# > 0 )) && notice_due "$rc" "$1"; then
    pushed=$(cat "$NOTICE_FILE" 2>/dev/null)
    billing_notice "$1" "$2" "$3" "${pushed:-$4}" "$5" >&2
  fi
  rm -f "$NOTICE_FILE"
  lock_release
}

# arm_notice <instance-id|""> <type> <launch-epoch|""> <stop> — from here on,
# a failure or Ctrl-C says the host is billing, and which stop is armed
# (state.sh armed_stop: deadman, idle or either). "" means a launch or start
# call is in flight. The values are quoted into the trap now, on purpose.
# shellcheck disable=SC2064
arm_notice() { trap "on_exit $(printf '%q ' "$@" "$IDLE_MINUTES")" EXIT; }

# notice_signal <stop> — once this up's push has armed the idle timer (and
# disarmed the dead-man timer), the billing notice names that stop, for the
# rest of this up (a later restart boots with it armed too). up_connect runs
# in a subshell, which has no traps and can't set this shell's, and a Ctrl-C
# ends both before either could pass a value back, so it is a file beside
# the lock, named for this process ($$ is the same in the subshell) and
# removed with it. Best effort: the state dir held the lock a moment ago.
readonly NOTICE_FILE="$STATE_DIR/stop.$$"
notice_signal() { printf '%s\n' "$1" > "$NOTICE_FILE" 2>/dev/null || true; }

# notice_due <exit-status> <instance-id|""> -> 0 when the notice must print.
# A known host: on any failure. A call in flight: only when its outcome is
# unknown (network error or a signal); a service error means EC2 refused it.
notice_due() {
  (( $1 != 0 )) || return 1
  [[ -z $2 ]] || return 0
  (( $1 == EX_NET || $1 > 128 ))
}

# --- Lab key -----------------------------------------------------------------
# Invariant: the lab key is never regenerated while a tagged instance exists.
# Only the create path (no instance) may generate it; every other path checks
# it against the instance's KeyFingerprint tag and names destroy on failure.

# lab_key_fingerprint -> the key's SHA256 fingerprint, or nothing when either
# half is missing or unreadable (state.sh lab_key_verdict says "missing")
lab_key_fingerprint() {
  local line
  [[ -f $LAB_KEY && -f $LAB_KEY.pub ]] || return 0
  line=$(ssh-keygen -lf "$LAB_KEY.pub" 2>/dev/null) || return 0
  fingerprint_of "$line" || return 0
}

# lab_key_require_pub — the private half alone is not lost: say how to rebuild the public half
lab_key_require_pub() {
  [[ ! -f $LAB_KEY || -f $LAB_KEY.pub ]] || die "$EX_FAIL" "the lab key's public half $LAB_KEY.pub is missing" \
    "rebuild it from the private key: ssh-keygen -y -f $LAB_KEY > $LAB_KEY.pub"
}

# lab_key_ensure — create path only (no instance exists): reuse the key at
# the fixed path, or generate it. ssh-keygen asks for the passphrase itself,
# which needs a terminal.
lab_key_ensure() {
  lab_key_require_pub
  [[ ! -f $LAB_KEY ]] || return 0
  [[ -t 0 ]] || die "$EX_USAGE" "the lab key $LAB_KEY does not exist yet, and creating it asks for a passphrase" \
    'run helios-lab up in a terminal'
  [[ -d $HOME/.ssh ]] || mkdir -m 700 "$HOME/.ssh"
  echo "creating the lab key $LAB_KEY (ed25519): choose a passphrase"
  ssh-keygen -q -t ed25519 -a 100 -C helios-lab -f "$LAB_KEY" \
    || die "$EX_FAIL" "ssh-keygen could not create $LAB_KEY; nothing was created in AWS"
  if ssh-keygen -y -P '' -f "$LAB_KEY" >/dev/null 2>&1; then
    warn "$LAB_KEY has no passphrase; add one any time: ssh-keygen -p -f $LAB_KEY"
  fi
  echo "back up $LAB_KEY: the guest accepts only this key, and helios-lab never regenerates it"
}

# lab_key_check <instance-id> — the key must be the one the instance was created with
lab_key_check() {
  local tag fp
  tag=$(aws_instance_key_tag "$1")
  lab_key_require_pub
  fp=$(lab_key_fingerprint)
  case $(lab_key_verdict "$fp" "$tag") in
    ok)       return 0 ;;
    missing)  key_lost "the lab key $LAB_KEY is missing, and lab instance $1 exists" ;;
    mismatch) key_lost "the lab key $LAB_KEY ($fp) is not the key $1 was created with (${tag/#None/no KeyFingerprint tag})" ;;
  esac
}

# key_lost <message> — dies naming destroy as the only recovery
key_lost() {
  die "$EX_CONFLICT" "$1" 'the guest accepts only the key it was created with, and helios-lab never regenerates it' \
    'restore the key from your backup, or start over: helios-lab destroy (the instance, its disk and the guest go)'
}

# --- Discovery ---------------------------------------------------------------
# discover_single -> the one live lab instance's row, or nothing when absent.
# Invariant: at most one live tagged instance exists. More than one is a state
# conflict (exit 4) listing every ID, never auto-resolved. Every command except
# status and destroy goes through here. Callers: declare the local first, then
# assign (`local row; row=$(discover_single)`), or `local` masks the exit code.
discover_single() {
  local rows
  rows=$(aws_discover_instances)
  (( $(count_rows "$rows") <= 1 )) \
    || die "$EX_CONFLICT" "$(duplicates_message "$rows")" "helios-lab status lists them"
  printf '%s' "$rows"
}

# --- status ------------------------------------------------------------------
# Read-only by construction. Invariant: status never mutates AWS or host state.
# It calls only describe-* operations and checkip; the suite checks every
# status scenario's recorded calls. Order: anomalies, then the money-and-time
# line, then details.
cmd_status() {
  local rows
  rows=$(aws_discover_instances)
  case $(count_rows "$rows") in
    0) status_absent ;;
    1) status_one "$rows" ;;
    *) duplicates_report "$rows" ;;
  esac
}

# status_absent — no instance; a lab security group left behind is an anomaly
status_absent() {
  local groups group
  groups=$(aws_discover_groups)
  while IFS= read -r group; do
    [[ -z $group ]] || anomaly orphan-group "$group"
  done <<< "$groups"
  status_headline absent
}

# status_one <row> — a running host is also probed over ssh (U3): one
# 3-second, read-only look at its provisioning, its idle check (U4) and its
# guest (lib/remote.sh host_probe), and only when this Mac's IP is allowed.
# The probe goes first, so its anomalies print above the headline too. The
# auto-stop field is the host's own: a keep's deadline, the idle countdown,
# or the dead-man time while that is the stop armed (probe_autostop).
status_one() {
  local id state type az ip launch group code reason now deadman access='' probe=''
  IFS=$US read -r id state type az ip launch group code reason <<< "$1"
  now=$(date +%s)
  deadman=$(deadman_epoch "$(launch_epoch "$launch" "$now")")
  if [[ $state == running ]]; then
    access=$(caller_access "$group") || return
    probe=$(host_probe "$id" "$ip" "$access")
  fi
  status_anomalies "$state" "$reason" "$now" "$access"
  probe_anomalies "$probe" "$deadman"
  status_headline "$state" "$type" "$(uptime_s "$launch" "$now")" "$(stop_cause "$code" "$reason")" \
    "$(guest_headline_field "$state" "$id" "$probe")" "$(probe_autostop "$probe" "$now" "$deadman" "$IDLE_MINUTES")"
  status_details "$id" "$az" "$type" "$ip"
  [[ $state != running ]] || probe_details "$probe"
}

# status_anomalies <state> <reason> <now> <caller access>
status_anomalies() {
  local stuck
  case $1 in
    stopping) if stuck=$(stuck_for "$2" "$3"); then anomaly stuck-stopping "$stuck"; fi ;;
    running)  case $4 in
                denied*) anomaly ip-not-allowed "${4#denied }" ;;
                unknown) anomaly ip-unknown ;;
              esac ;;
  esac
}

# caller_access <group-id> -> allowed | denied <ipv4> | unknown | none.
# Only a running host is connectable, so only then does a stale ingress
# rule matter. A failed IP lookup is itself an anomaly (unknown).
caller_access() {
  local ip rules
  [[ $1 != None && -n $1 ]] || { echo none; return 0; }
  ip=$(caller_ip) || { echo unknown; return 0; }
  rules=$(aws_ingress_rules "$1") || return
  if ingress_allows "$ip" "$rules"; then echo allowed; else echo "denied $ip"; fi
}

# guest_headline_field <state> <instance-id> <probe> -> the headline's guest
# field: a running host's from its probe; a stopped host can't be asked,
# but stop keeps the disk, so a guest this Mac has reached (its alias is
# pinned, which only a reached guest leaves, and up drops for any guest not
# verified yet) is intact; otherwise nothing
guest_headline_field() {
  case $1 in
    running) [[ $(probe_kind "$3") != ok ]] || guest_field "$(probe_body "$3")" ;;
    stopped) if hostkey_pinned "$2-guest"; then echo 'guest intact'; fi ;;
  esac
}

# --- up ----------------------------------------------------------------------
# Converges from any EC2 state to "host running" by the state machine in
# state.sh (up_action), then bootstraps the host and boots the guest
# (up_connect). -v adds the host's provisioning journal. UP_VERBOSE and
# UP_STARTED (for the ready screen's elapsed time) are set once, here, and
# only read.
cmd_up() {
  local mode started
  mode=$(up_mode "$@")
  started=$(date +%s)
  readonly UP_VERBOSE=$mode UP_STARTED=$started
  require_jump_safe
  lock_acquire
  local row id state type az ip launch rest
  row=$(discover_single)
  IFS=$US read -r id state type az ip launch rest <<< "$row"
  case $(up_action "${state:-absent}") in
    create)           up_create ;;
    wait-then-create) up_wait "$id" instance-terminated terminating; up_create ;;
    start)            up_existing "$row"; up_start "$id" "$type" "$az" ;;
    wait-then-start)  up_existing "$row"; up_wait "$id" instance-stopped stopping; up_start "$id" "$type" "$az" ;;
    none)             up_existing "$row"
                      arm_notice "$id" "$type" "$(launch_epoch "$launch" "$(date +%s)")" either
                      up_running "$id" '' either ;;
  esac
}

# up_mode <args...> -> quiet | verbose
up_mode() {
  case $#:${1:-} in
    0:)   echo quiet ;;
    1:-v) echo verbose ;;
    *)    die "$EX_USAGE" 'up takes no argument but -v' "try: $SELF help" ;;
  esac
}

# up_wait <instance-id> <waiter> <doing> — wait out a transition before acting
up_wait() {
  echo "waiting for $1 to finish $3"
  aws_wait "$2" --instance-ids "$1"
}

# up_existing <row> — before a known instance costs anything more: its key
# must be the lab key, the type override can't apply, and the group admits
# exactly this Mac (the ingress refresh every connecting command runs)
up_existing() {
  local id state type az ip launch group rest note
  IFS=$US read -r id state type az ip launch group rest <<< "$1"
  lab_key_check "$id"
  note=$(type_override_note "${HELIOS_LAB_INSTANCE_TYPE:-}" "$type" "$id")
  [[ -z $note ]] || warn "$note"
  [[ -n $group && $group != None ]] || die "$EX_FAIL" "$id has no security group" 'helios-lab status shows the details'
  ingress_refresh "$group"
}

# ingress_refresh <group-id> — the first step of every connecting command
# (R10): ingress becomes exactly this Mac's /32 on tcp/22 (one line when that
# changes), egress exactly tcp 80/443. up runs it before any start; U3's ssh
# and console run it, then host_reach (lib/remote.sh).
ingress_refresh() {
  local caller
  caller=$(caller_ip_or_die)
  sg_converge "$1" "$caller"
}

# up_create — absent: preflight (the cost line before the dry-run), the lab
# key, the group, then one launch
up_create() {
  check_guest_fits
  local cli account vpc placement caller fp found group
  cli=$(preflight_cli)
  account=$(preflight_account)
  cost_line "$account" "$INSTANCE_TYPE" "$REGION"
  vpc=$(preflight_vpc)
  placement=$(preflight_placement "$vpc" "$INSTANCE_TYPE")
  aws_dry_run_launch "$INSTANCE_TYPE" "${placement%%"$US"*}"
  echo "preflight ok · aws-cli $cli · zone ${placement#*"$US"} · RunInstances dry-run passed"
  caller=$(caller_ip_or_die)
  lab_key_ensure
  fp=$(lab_key_fingerprint)
  [[ -n $fp ]] || die "$EX_FAIL" "cannot read the fingerprint of $LAB_KEY.pub"
  found=$(lab_group "$vpc")
  group=${found%%"$US"*}
  echo "security group $group ${found#*"$US"}"
  sg_converge "$group" "$caller"
  up_launch "$placement" "$group" "$fp"
}

# check_guest_fits — a type too small for the guest is a usage error at create
check_guest_fits() {
  guest_fits "$INSTANCE_TYPE" && return 0
  die "$EX_USAGE" \
    "HELIOS_LAB_INSTANCE_TYPE=$INSTANCE_TYPE is too small: the guest alone takes $GUEST_VCPUS vCPU and $GUEST_MEM_GIB GiB" \
    'use at least 4 vCPU and 16 GiB, e.g. m8i.xlarge (the default), c8i.2xlarge or r8i.xlarge'
}

# lab_group <vpc-id> -> "group-id<US>created|reused": the lab group, found by
# both tags and its name (an orphan from an earlier run is reused), or
# created, tagged in the same call
lab_group() {
  local groups group
  groups=$(aws_discover_groups) || return
  case $(count_rows "$groups") in
    0) group=$(aws_create_group "$1") || return
       printf '%s\037created\n' "$group" ;;
    1) printf '%s\037reused\n' "$groups" ;;
    *) die "$EX_CONFLICT" "$(count_rows "$groups") lab security groups exist: $(row_ids "$groups")" \
         'delete the extra one by hand; helios-lab status shows the instance' ;;
  esac
}

# sg_converge <group-id> <caller-ipv4> — egress to exactly tcp 80/443, ingress
# to exactly tcp/22 from the caller's /32 (R10). One describe; no further
# call and no output when already there.
sg_converge() {
  local rules egress ingress
  rules=$(aws_group_rules "$1")
  egress=$(egress_plan "$rules")
  ingress=$(ingress_plan "$2" "$rules")
  aws_sg_apply "$1" egress "$egress"
  aws_sg_apply "$1" ingress "$ingress"
  sg_note egress 'tcp 80/443 only' "$egress"
  sg_note 'ssh ingress' "$2/32 only" "$ingress"
}

# caller_ip_or_die -> this Mac's public IPv4: the one address ingress admits
caller_ip_or_die() {
  caller_ip || die "$EX_NET" "could not read this Mac's public IPv4 from $CHECKIP_URL" \
    'the security group admits ssh from exactly that address; check the network and retry'
}

# up_launch <subnet-id<US>az> <group-id> <key-fingerprint> — the one launch.
# A launch call in flight already arms the notice: interrupted, nobody knows
# whether a host exists. Until its first push, a host this up launched has
# exactly the user-data dead-man timer armed.
up_launch() {
  local subnet=${1%%"$US"*} az=${1#*"$US"} user_data started launched id launch
  user_data=$(render_user_data "$(cat "$LAB_KEY.pub")") \
    || die "$EX_FAIL" "$LAB_KEY.pub is not an ed25519 public key"
  started=$(date +%s)
  arm_notice '' "$INSTANCE_TYPE" '' deadman
  launched=$(aws_launch "$INSTANCE_TYPE" "$subnet" "$az" "$2" "$3" "$user_data")
  IFS=$US read -r id launch <<< "$launched"
  arm_notice "$id" "$INSTANCE_TYPE" "$(launch_epoch "$launch" "$started")" deadman
  echo "instance $id launched in $az · waiting for running"
  up_running "$id" "$started" deadman
}

# up_start <instance-id> <type> <az> [connect] — [connect] as up_running's.
# An existing host: which stop is armed depends on whether an earlier up
# finished its push, so the notice says either until this up's push.
up_start() {
  local started
  started=$(date +%s)
  echo "starting $1 · billing resumes at $(hourly_cost "$2")"
  arm_notice '' "$2" '' either
  aws_start "$1" "$2" "$3"
  arm_notice "$1" "$2" "$started" either
  up_running "$1" "$started" either "${4:-up_connect_following}"
}

# up_running <instance-id> <started-epoch|""> <stop> [connect] — wait for
# running, then the post-launch re-lookup, then connect: up_connect_following,
# unless a caller that already followed a stop names plain up_connect. <stop>
# is the stop armed until this up's push (state.sh armed_stop). Invariant: at
# most one live tagged instance; a duplicate (another Mac's concurrent up,
# say) exits 4 and is never resolved automatically.
up_running() {
  aws_wait instance-running --instance-ids "$1"
  local row id state type az ip launch rest boot
  row=$(discover_single)
  IFS=$US read -r id state type az ip launch rest <<< "$row"
  [[ $id == "$1" && $state == running ]] || die "$EX_CONFLICT" \
    "after waiting for $1 to run, discovery found: $(instance_list "$row")" 'helios-lab status shows the details'
  boot=$(launch_epoch "$launch" "$(date +%s)")
  arm_notice "$id" "$type" "$boot" "$3"
  [[ -z $2 ]] || echo "instance $id running · $(fmt_elapsed $(( $(date +%s) - $2 )))"
  running_line "$id" "$ip" "$type" "$(deadman_epoch "$boot")" "$3"
  "${4:-up_connect_following}" "$row"
}

# up_connect_following <row> — up_connect, and when ssh to the host fails on
# the network (exit 8), EC2 is asked again (plan: Host lifecycle): an idle
# poweroff can land between "saw running" and "connected", so that failure
# is named rather than left to time out, and up follows the state machine.
# up_connect runs in a subshell to catch its exit; errexit is set inside it,
# because bash ignores -e in a subshell whose status is tested. The subshell
# has no traps (bash resets them), so the billing notice prints once, here.
up_connect_following() {
  local rc
  set +e
  ( set -e; up_connect "$1" )
  rc=$?
  set -e
  (( rc != 0 )) || return 0
  (( rc == EX_NET )) || exit "$rc"
  up_follow_stop "$1" "$rc"
}

# up_follow_stop <row> <exit status> — a host found stopping or stopped is
# named, waited out and started again, then connected once more, without a
# second follow. Anything else (still running, gone) keeps the ssh failure,
# already reported, and its exit status.
up_follow_stop() {
  local row id state type az ip launch group code reason
  row=$(discover_single)
  IFS=$US read -r id state type az ip launch group code reason <<< "$row"
  case $(up_action "${state:-absent}") in
    wait-then-start) echo "$(stopped_while_connecting "$id" "$code" "$reason") · up follows it"
                     up_wait "$id" instance-stopped stopping ;;
    start)           echo "$(stopped_while_connecting "$id" "$code" "$reason") · up follows it" ;;
    *)               exit "$2" ;;
  esac
  up_start "$id" "$type" "$az" up_connect
}

# up_connect <row> — the host bootstrap (U2), then the guest (U3). Runs once
# the instance is running and the re-lookup has passed, with the billing
# notice armed, so any failure here prints it. The host key is verified
# against the console on first contact, the fragment is rendered for this
# IP, host/ and its config are pushed (every up: R13), and the provision
# unit is started and followed stage by stage: packages, libvirt, guard,
# engvm, seed (with the RFD 26 line) and guest. Then the smoke check through
# the guest alias (lib/remote.sh guest_bringup) and the ready screen, with
# the keep in force, if any.
# Invariant: from launch onward every boot has a stop armed. The push's
# install arms the idle timer before it disarms the dead-man timer, and dies
# otherwise, so once host_push returns the idle timer is the stop armed, and
# the notice says so from then on (notice_signal).
up_connect() {
  local id state type az ip launch rest pushed reply
  IFS=$US read -r id state type az ip launch rest <<< "$1"
  host_reach "$id" "$ip"
  pushed=$(host_push) || return
  push_line
  notice_signal idle
  provision_start
  provision_follow "$pushed"
  [[ ${UP_VERBOSE:-quiet} != verbose ]] || provision_journal_print
  echo 'host ready · KVM, libvirt and the metadata guard are in place'
  reply=$(host_status) || return
  guest_bringup "$id" "$reply"
  ready_screen "$(up_elapsed)" "$IDLE_MINUTES" "$(inhibit_of "$reply")"
}

# up_elapsed -> seconds since this up started, or nothing outside cmd_up
up_elapsed() { [[ -z ${UP_STARTED:-} ]] || echo $(( $(date +%s) - UP_STARTED )); }

# require_jump_safe — the guest alias rides ProxyJump, and ssh builds that
# hop as a shell command with the -F path unquoted (lib/render.sh). A state
# dir that needs quoting would break the guest's ssh only at the very end of
# up, after the host has billed for the whole build, so it is refused first.
require_jump_safe() {
  jump_safe_path "$SSH_CONFIG" || die "$EX_USAGE" \
    "the state dir $STATE_DIR has characters ssh's ProxyJump can't pass on to reach the guest" \
    'set HELIOS_LAB_STATE_DIR to an absolute path of letters, digits and / . _ - only'
}

# --- ssh and console ---------------------------------------------------------
# Both reach a running host only. Explicit over implicit: against any other
# state they refuse with the stop cause (U1) and never start the host, which
# would bill. Like up they refresh ingress first (R10), check the lab key and
# pin the host's key (host_reach), then hand the terminal to ssh. Their own
# notices go to stderr, so `helios-lab ssh guest cmd > file` captures only
# cmd's output. Neither takes the lock: they change nothing up guards.
readonly SESSIONS_NEVER_START="$SELF ssh and console never start the host themselves: it bills while it runs"

# cmd_ssh [guest|host] [cmd...] — the guest by default; extra words are the
# remote command, joined as ssh joins them
cmd_ssh() {
  local alias command
  alias=$(ssh_alias "$@")
  command=$(ssh_command "$@")
  [[ $alias != guest ]] || require_jump_safe
  connect_running "$SESSIONS_NEVER_START" >&2
  ssh_session "$alias" "$command"
}

# cmd_console — the guest's serial console, through the host (only host root
# and the libvirt group can reach it). --force takes the console from any
# other session, the first-boot transcript logger included: a guest whose
# first boot loses its logger that way, before up verified it, is recreated
# by the next up.
cmd_console() {
  (( $# == 0 )) || die "$EX_USAGE" 'console takes no arguments' "try: $SELF help"
  connect_running "$SESSIONS_NEVER_START" >&2
  console_session
}

# connect_running <why it refuses a host that isn't running> — the one live
# instance must be running; then the steps every connecting command takes
# before its first ssh
connect_running() {
  local row id state type az ip launch group code reason
  row=$(discover_single)
  IFS=$US read -r id state type az ip launch group code reason <<< "$row"
  [[ $state == running ]] || die "$EX_FAIL" "$(not_running_message "${state:-absent}" "$id" "$code" "$reason")" "$1"
  lab_key_check "$id"
  [[ -n $group && $group != None ]] || die "$EX_FAIL" "$id has no security group" 'helios-lab status shows the details'
  ingress_refresh "$group"
  host_reach "$id" "$ip"
}

# --- keep --------------------------------------------------------------------
# keep <duration>|off — holds off the idle auto-stop until a deadline at most
# 12h ahead, or clears it. Like ssh it reaches a running host only (ingress,
# the lab key, the pinned host key) and never starts one. The host takes the
# deadline on its own clock, enforces the cap again, and keeps it on disk,
# so it survives a stop and start: it is a wall-clock deadline, inert once
# passed. After it, the idle window counts again from its start. No lock:
# keep changes nothing up, stop or destroy guard.
cmd_keep() {
  local arg reply line
  arg=$(keep_arg "$@")
  connect_running "$SELF keep never starts the host: it bills while it runs"
  reply=$(keep_set "$arg")
  line=$(keep_line "$reply" "$IDLE_MINUTES") \
    || die "$EX_FAIL" "the host answered '$(first_line "$reply")' to keep, neither a deadline nor off" \
         'helios-lab up pushes the current helper'
  echo "$line"
}

# keep_arg <args...> -> the host helper's argument: seconds, or off. A usage
# error before any AWS call for anything else (state.sh keep_seconds).
keep_arg() {
  (( $# == 1 )) || die "$EX_USAGE" 'keep takes one argument: a duration up to 12h (90m, 3h) or off' "try: $SELF help"
  [[ $1 != off ]] || { echo off; return 0; }
  keep_seconds "$1" || die "$EX_USAGE" "keep: '$1' is not a duration from 1m to 12h" \
    "e.g. $SELF keep 90m, $SELF keep 3h, or $SELF keep off"
}

# --- stop --------------------------------------------------------------------
# Stops, never terminates. Invariant: destroy --yes is the only path that
# terminates anything.
cmd_stop() {
  (( $# == 0 )) || die "$EX_USAGE" 'stop takes no arguments'
  lock_acquire
  local row id state rest
  row=$(discover_single)
  IFS=$US read -r id state rest <<< "$row"
  case $(stop_action "${state:-absent}") in
    absent)         echo 'absent · no lab instance · nothing to stop' ;;
    terminating)    echo "shutting-down · $id is being terminated · nothing to stop" ;;
    already)        echo "already $(stopped_line)" ;;
    wait)           stop_wait "$id" ;;
    stop)           aws_stop "$id"; stop_wait "$id" ;;
    wait-then-stop) up_wait "$id" instance-running starting; aws_stop "$id"; stop_wait "$id" ;;
  esac
}

# stop_wait <instance-id>
stop_wait() {
  echo "stopping $1 · waiting for stopped"
  aws_wait instance-stopped --instance-ids "$1"
  stopped_line
}

# --- destroy -----------------------------------------------------------------
# Without --yes: a read-only preview, exit 2. With --yes: the same preview,
# from the same discovery, then exactly those deletions. Invariant: destroy
# --yes is the only path that terminates, and it terminates only what it
# previewed. The lab key is never touched.
cmd_destroy() {
  local mode rows groups volumes
  mode=$(destroy_mode "$@")
  [[ $mode == preview ]] || lock_acquire
  rows=$(aws_discover_instances)
  groups=$(aws_discover_groups)
  volumes=$(destroy_volumes "$rows")
  if [[ -z $rows && -z $groups ]]; then
    echo 'nothing to destroy · no lab instance or security group'
    return 0
  fi
  case $mode in
    preview) destroy_preview 'destroy would delete:' "$rows" "$volumes" "$groups" "$LAB_KEY"
             echo "to delete exactly this: $SELF destroy --yes"
             exit "$EX_USAGE" ;;
    yes)     destroy_preview 'destroying:' "$rows" "$volumes" "$groups" "$LAB_KEY"
             destroy_apply "$rows" "$volumes" "$groups" ;;
  esac
}

# destroy_mode <args...> -> preview | yes
destroy_mode() {
  case $#:${1:-} in
    0:)      echo preview ;;
    1:--yes) echo yes ;;
    *)       die "$EX_USAGE" 'destroy takes no argument but --yes' "preview first: $SELF destroy" ;;
  esac
}

# destroy_volumes <instance-rows> -> their root volumes (Q_ROOT_VOLUMES rows)
destroy_volumes() {
  [[ -n $1 ]] || return 0
  local -a ids=()
  read -r -a ids <<< "$(row_ids "$1")"
  aws_root_volumes "${ids[@]}"
}

# destroy_apply <instance-rows> <volume-rows> <group-ids>
destroy_apply() {
  local -a ids=() vols=() groups=()
  read -r -a ids <<< "$(row_ids "$1")"
  read -r -a vols <<< "$(deleted_volumes "$2")"
  read -r -a groups <<< "$(row_ids "$3")"
  if (( ${#ids[@]} > 0 )); then
    echo "terminating ${ids[*]} · waiting for terminated"
    aws_terminate "${ids[@]}"
    aws_wait instance-terminated --instance-ids "${ids[@]}"
  fi
  (( ${#vols[@]} == 0 )) || aws_wait volume-deleted --volume-ids "${vols[@]}"
  (( ${#groups[@]} == 0 )) || destroy_groups "${groups[@]}"
  destroy_confirm_volumes
  echo "destroyed · no lab instance, volume or security group remains · kept: the lab key $LAB_KEY"
}

# destroy_groups <group-id>... — after the instances, whose ENIs hold them
destroy_groups() {
  local group
  for group in "$@"; do
    aws_delete_group "$group" "$SG_DELETE_ATTEMPTS" "$RETRY_SECONDS"
    echo "security group $group deleted"
  done
}

# destroy_confirm_volumes — no lab-tagged volume may outlive destroy: a
# leftover would bill as storage, unseen
destroy_confirm_volumes() {
  local left
  left=$(aws_discover_volumes)
  [[ -z $left ]] || die "$EX_FAIL" "lab-tagged volumes remain: $(row_ids "$left")" \
    'they bill as storage until deleted: delete them in the EC2 console (helios-lab never deletes a volume itself)'
}

# --- runbook -----------------------------------------------------------------
# The hands-on DTrace, MDB and RFD 26 steps (R11) ship beside the libraries.
# Only the path is printed, so it composes: less "$(helios-lab runbook)".
readonly RUNBOOK="$HELIOS_LAB_HOME/runbook.md"

cmd_runbook() {
  (( $# == 0 )) || die "$EX_USAGE" 'runbook takes no arguments' "try: $SELF help"
  [[ -r $RUNBOOK ]] || die "$EX_FAIL" "the runbook is missing: expected $RUNBOOK" \
    'run yadm pull, or set HELIOS_LAB_HOME'
  echo "$RUNBOOK"
}

# --- help --------------------------------------------------------------------
cmd_help() {
  cat <<EOF
$SELF: an x86 Helios (illumos) VM on AWS, for DTrace and MDB.

usage: $SELF <command>

commands:
  up [-v]                 create or start the host, boot the guest, check DTrace
                          (-v also prints the host's provisioning journal)
  stop                    stop the host; its disk and the guest are kept
  status                  state, cost so far and auto-stop time; anomalies first
  ssh [guest|host] [cmd]  ssh into the guest (default) or the host
  console                 attach to the guest's serial console
  keep <duration>|off     hold off the idle auto-stop (at most 12h), or clear it
  destroy [--yes]         preview what would be deleted; --yes deletes exactly that
  runbook                 print the path of the DTrace and MDB runbook
  help                    show this screen

environment:
  HELIOS_LAB_PROFILE        AWS profile (default: helios-lab)
  HELIOS_LAB_INSTANCE_TYPE  instance type, used only at create (default: m8i.xlarge)
                            families: c8i m8i r8i (and -flex), c7i m7i r7i;
                            at least 4 vCPU and 16 GiB
  HELIOS_LAB_IDLE_MINUTES   idle minutes before the host stops itself (default: 60)

Region $REGION. Costs are approximate (prices as of $PRICE_DATE).
EOF
}

# --- Dispatch ----------------------------------------------------------------
main() {
  local cmd=${1:-}
  case $cmd in
    help|-h|--help) cmd_help; return 0 ;;
    '')             cmd_help >&2; exit "$EX_USAGE" ;;
  esac
  shift
  validate_config
  case $cmd in
    status)          (( $# == 0 )) || die "$EX_USAGE" 'status takes no arguments'
                     cmd_status ;;
    up)              cmd_up "$@" ;;
    stop)            cmd_stop "$@" ;;
    destroy)         cmd_destroy "$@" ;;
    ssh)             cmd_ssh "$@" ;;
    console)         cmd_console "$@" ;;
    keep)            cmd_keep "$@" ;;
    runbook)         cmd_runbook "$@" ;;
    *)               die "$EX_USAGE" "unknown command: $cmd" "try: $SELF help" ;;
  esac
}

# Run only when executed, so tests can source this file and call its functions.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
