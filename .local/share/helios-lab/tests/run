#!/bin/bash
#
# tests/run — the helios-lab suite: every *.test.sh under stock /bin/bash
# (the Mac-side target), then shellcheck over every script. Exits 0 only when
# everything passes.
#
#   .local/share/helios-lab/tests/run            # all test files
#   .local/share/helios-lab/tests/run lifecycle  # files matching *lifecycle*
#
# policy.test.sh always runs last, whatever order the glob gives the rest: it
# checks the shipped IAM policy against the ledger of aws calls every earlier
# file made (STUB_AWS_LEDGER, tests/stubs/aws). Only an unfiltered run records
# the whole suite, so only then does it also require every granted action to
# be exercised (STUB_AWS_LEDGER_COMPLETE=yes).
#
# Safety: no test may reach AWS, a host or the network. tests/stubs goes
# first on PATH, and the run refuses to start unless every network tool the
# command could run resolves there: aws, curl, ssh, ssh-keyscan, and scp
# (a tripwire: helios-lab never uses it). As a second net, AWS config and
# credential files point at /dev/null and every AWS_* credential variable is
# unset, so even a stray real CLI could not authenticate.
set -euo pipefail

readonly SELF=tests/run
die() { printf '%s: %s\n' "$SELF" "$1" >&2; exit 1; }

TESTS_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
readonly TESTS_DIR

# --- Environment -------------------------------------------------------------
export HELIOS_LAB_HOME=${TESTS_DIR%/tests}
HELIOS_LAB_BIN=$(cd "$HELIOS_LAB_HOME/../../bin" && pwd)/helios-lab
export HELIOS_LAB_BIN
export PATH="$TESTS_DIR/stubs:$PATH"
export AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null AWS_EC2_METADATA_DISABLED=true
unset AWS_PROFILE AWS_DEFAULT_PROFILE AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN \
  AWS_REGION AWS_DEFAULT_REGION HELIOS_LAB_PROFILE HELIOS_LAB_INSTANCE_TYPE HELIOS_LAB_IDLE_MINUTES \
  HELIOS_LAB_RETRY_SECONDS HELIOS_LAB_HOST_ROOT SSH_AUTH_SOCK

for tool in aws curl ssh ssh-keyscan scp; do
  [[ $(command -v "$tool") == "$TESTS_DIR/stubs/$tool" ]] \
    || die "refusing to run: $tool resolves to $(command -v "$tool"), not the stub"
done

TEST_TMP=$(mktemp -d "${TMPDIR:-/tmp}/helios-lab-tests.XXXXXX")
export TEST_TMP TEST_RESULTS=$TEST_TMP/results HELIOS_LAB_STATE_DIR=$TEST_TMP/state
trap 'rm -rf "$TEST_TMP"' EXIT
export STUB_AWS_LEDGER=$TEST_TMP/aws-calls STUB_AWS_LEDGER_COMPLETE=no
: > "$STUB_AWS_LEDGER"
[[ -n ${1:-} ]] || STUB_AWS_LEDGER_COMPLETE=yes

# --- Tests -------------------------------------------------------------------
# A file that dies before reporting (say, a syntax error) counts as a failure.
readonly LAST=$TESTS_DIR/policy.test.sh
broken=0 last_due=no
run_file() {
  echo "${1##*/}"
  /bin/bash "$1" || { broken=$(( broken + 1 )); echo "  FAIL  ${1##*/} exited non-zero"; }
}
for file in "$TESTS_DIR"/*"${1:-}"*.test.sh; do
  [[ -e $file ]] || die "no test files match '${1:-}'"
  if [[ $file == "$LAST" ]]; then last_due=yes; else run_file "$file"; fi
done
[[ $last_due == no ]] || run_file "$LAST"

passed=0 failed=0
if [[ -f $TEST_RESULTS ]]; then
  while read -r p f; do passed=$(( passed + p )); failed=$(( failed + f )); done < "$TEST_RESULTS"
fi
echo
echo "$passed passed, $failed failed"

# --- Lint --------------------------------------------------------------------
# The linter backs the suite. Not installed: say so loudly, don't fail.
# Every script of the command: the entry, its libraries, the host helper
# (bash on the host, sourced under 3.2 here) and the guest sizing engvm's
# create.sh sources, the runner, helpers and stubs.
lint=0 scripts=()
for file in "$HELIOS_LAB_BIN" "$HELIOS_LAB_HOME"/lib/*.sh "$HELIOS_LAB_HOME"/host/helios-lab-host \
  "$HELIOS_LAB_HOME"/host/engvm-lab.sh \
  "$TESTS_DIR"/run "$TESTS_DIR"/derive-text "$TESTS_DIR"/*.sh "$TESTS_DIR"/stubs/*; do
  [[ ! -f $file ]] || scripts+=("$file")
done
if command -v shellcheck >/dev/null 2>&1; then
  if shellcheck -x "${scripts[@]}"; then echo "shellcheck: clean (${#scripts[@]} files)"
  else lint=1; echo 'shellcheck: FAILED'
  fi
else
  echo 'shellcheck: SKIPPED, not installed (brew bundle --global)'
fi

(( failed == 0 && broken == 0 && lint == 0 ))
