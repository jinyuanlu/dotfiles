#!/bin/bash
#
# helios-lab-host — the host side of helios-lab. On every `helios-lab up` the
# Mac pushes this file, the units beside it and a rendered host.conf
# (lib/remote.sh host_push), runs `install` on them, then starts
# helios-lab-provision.service, whose ExecStart is `provision`.
#
# Installed layout (`install` places what the push carries):
#   /usr/local/libexec/helios-lab/helios-lab-host   this helper, 0755
#   /etc/systemd/system/helios-lab-*.{service,timer} units from host/, 0644
#   /etc/helios-lab/host.conf                       the Mac's settings, 0644
#   /etc/helios-lab/engvm-lab.sh                    the guest's sizing, 0644
#   /etc/ssh/sshd_config.d/10-helios-lab.conf       sshd-helios-lab.conf, 0644
# Written by the idle check and keep (U4):
#   /run/helios-lab/idle                the last idle check's record (tmpfs:
#                                       the count starts again on every boot)
#   /var/lib/helios-lab/inhibit-until   keep's deadline (disk: see cmd_keep)
# Written by provisioning:
#   /var/lib/helios-lab/stage.<stage>   marker: the input the stage was built from
#   /var/lib/helios-lab/progress        the current run's progress (protocol below)
#   /etc/helios-lab/guard.nft and /etc/systemd/system/helios-lab-guard.service
#                                       the metadata guard and its boot-time loader
#   /home/ubuntu/helios-engvm           the engvm checkout at the pin, owned by
#                                       ubuntu, with config/lab.sh and the seed
#   /var/lib/helios-lab/guest.built     what the current guest was created from
#   /var/log/helios-lab/console.log     the guest's first-boot console transcript
# Written only on the Mac's word, after its smoke check passed:
#   /var/lib/helios-lab/guest-verified  the guest marker (single-marker protocol)
#
# Subcommands:
#   install <dir>    place the pushed files, reload systemd and sshd, restart
#                    the idle window, arm the idle timer, then disarm the
#                    dead-man timer, print the epoch (root; the push)
#   provision        run the stages under a lock (root; the unit's ExecStart)
#   progress-reset   empty the progress file (root; the unit's ExecStartPre)
#   progress         print the progress file and the unit's state (the Mac polls)
#   journal [n|all]  the current run's journal lines (root; the Mac, on failure or -v)
#   status           progress, then the guest's state (sudo; up's poll, status's
#                    probe); read-only, like `helios-lab status` itself
#   guest-verified   record the guest as verified, free its console, autostart
#                    it (root; the Mac, once its smoke check passed)
#   guest-abandon    stop an unverified first boot's create unit, so the next
#                    provision run recreates the guest (root; the Mac, when the
#                    first boot never passed the smoke check)
#   idle-check       one idle check: reset, count or power off (root;
#                    helios-lab-idle.service's ExecStart, every 5 min)
#   keep <s>|off     hold off the idle stop for <s> seconds (at most 12h), or
#                    clear it; prints the deadline or "off" (root; helios-lab keep)
# Start provisioning only through the unit (systemctl start
# helios-lab-provision): it empties the progress file first, and a second run
# can't start while one is active. The lock covers a run started by hand.
#
# Stages, in order: packages, libvirt, guard, engvm, seed, guest.
# A stage that succeeds records its INPUT in its marker: a hash of everything
# it applies (stage_spec). The next run skips the stage only when the
# recorded input equals the pushed one (stage_decision) and its live check
# still passes (a reboot can lose what a stage set up). So a changed helper
# or setting re-applies (R13), a failed or interrupted stage runs again, and
# re-running provision on a completed host skips every stage but guest.
#
# The guest stage has no stage marker. It follows the single-marker protocol
# (plan: "Host and guest"), keyed on guest-verified, which only the Mac's
# smoke check leads to:
#   verified                       -> ensure the domain runs (and autostarts)
#   unverified, create unit active -> a first boot is under way: leave it
#   unverified otherwise           -> engvm destroy.sh, then create.sh
# Invariant: a verified guest is never destroyed or recreated here. A pushed
# pin or sizing that differs from what it was built with is reported (the
# stage summary, and the Mac's status and up), never applied.
#
# Progress protocol (lib/remote.sh parses it; keep both in step). One line
# per event, appended to the progress file and printed to the journal:
#   <epoch> <name> <event> [<message>]
#   name:    provision (the run itself) or a stage, [a-z][a-z0-9-]*
#   event:   start | done | skip | fail
#   message: one line; for fail, the reason; for done, an optional summary
# A run begins with "provision start" and ends with "provision done" or
# "provision fail <stage>". `progress` prints the file, then one last line:
#   unit <ActiveState> <Result>
#
# Bash: this runs as /bin/bash on Ubuntu 24.04, but the Mac suite sources it
# under macOS /bin/bash 3.2 to test its pure functions, so the whole file
# stays 3.2-safe, and main runs only when the file is executed.

readonly HOST_SELF=helios-lab-host
# Tests only: a sandbox prefix for every path this helper writes. Empty on
# the host (systemd and sudo both start it with a clean environment).
readonly ROOT_PREFIX=${HELIOS_LAB_HOST_ROOT:-}
readonly LIBEXEC_DIR=$ROOT_PREFIX/usr/local/libexec/helios-lab
readonly SYSTEMD_DIR=$ROOT_PREFIX/etc/systemd/system
readonly CONF_DIR=$ROOT_PREFIX/etc/helios-lab
readonly CONF_FILE=$CONF_DIR/host.conf
readonly MARKER_DIR=$ROOT_PREFIX/var/lib/helios-lab
readonly PROGRESS_FILE=$MARKER_DIR/progress
readonly PROVISION_LOCK=$ROOT_PREFIX/run/lock/helios-lab-provision.lock
readonly SERVICE=helios-lab-provision.service
readonly GUARD_SERVICE=helios-lab-guard.service
readonly GUARD_RULES=/etc/helios-lab/guard.nft   # as the guard unit names it

# The idle stop (U4). The dead-man timer comes from user-data (lib/render.sh)
# and powers the host off 2h after each boot until install disarms it.
readonly IDLE_TIMER=helios-lab-idle.timer
readonly IDLE_SERVICE=helios-lab-idle.service
readonly DEADMAN_TIMER=helios-lab-deadman.timer
readonly IDLE_RECORD=$ROOT_PREFIX/run/helios-lab/idle
readonly INHIBIT_FILE=$MARKER_DIR/inhibit-until
readonly UPTIME_FILE=$ROOT_PREFIX/proc/uptime
# sshd takes the first value it reads for a keyword, and reads its drop-ins
# in name order, ahead of the rest of sshd_config: "10-" goes first.
readonly SSHD_DROPIN=$ROOT_PREFIX/etc/ssh/sshd_config.d/10-helios-lab.conf
readonly SSH_SERVICE=ssh.service                 # Ubuntu's name for sshd's unit
readonly INPUT_TIMEOUT_S=10                      # each idle input, at most

readonly STAGES='packages libvirt guard engvm seed guest'
readonly LAB_USER=ubuntu
readonly LIBVIRT_URI=qemu:///system

# helios-engvm (R6): cloned and run as ubuntu, so the checkout, the seed
# download and the create share one owner and git's ownership check passes.
readonly ENGVM_REPO=https://github.com/oxidecomputer/helios-engvm.git
readonly ENGVM_HOME=/home/$LAB_USER/helios-engvm   # as the host sees it
readonly ENGVM_DIR=$ROOT_PREFIX$ENGVM_HOME
readonly LAB_CONF_FILE=$CONF_DIR/engvm-lab.sh
# download.sh links this name to the dated seed only once it is verified and
# unpacked, so its presence is the seed stage's live check.
readonly SEED_IMAGE=helios-qemu-ttya-full.raw
# download.sh retries forever when curl fails; the stage bounds it. The spike
# fetched, verified and unpacked the seed in 311 s.
readonly SEED_TIMEOUT_S=1200
readonly GUEST_VM=helios                          # engvm's default VM name
readonly CREATE_UNIT=helios-lab-create.service    # transient: systemd-run --collect
readonly LOG_DIR=$ROOT_PREFIX/var/log/helios-lab
readonly TRANSCRIPT=$LOG_DIR/console.log
readonly GUEST_BUILT=$MARKER_DIR/guest.built
readonly GUEST_VERIFIED=$MARKER_DIR/guest-verified
# create.sh uploads the 5 GB volume before it defines and starts the domain:
# about a minute in the spike. The stage waits this long for it to run.
readonly CREATE_WAIT_S=300
readonly TRANSCRIPT_LINES=20   # what status shows of a first boot's console
# The units progress and status report on. One `systemctl show` asks for
# them all (unit_show) and prints one block per unit, in the order asked,
# one blank line apart, so a unit's place in this list finds its block.
readonly STATUS_UNITS="$SERVICE $IDLE_TIMER $IDLE_SERVICE $DEADMAN_TIMER $CREATE_UNIT"
# helios-engvm needs Ubuntu's QEMU (its domain XML names pc-i440fx-focal);
# libnss-libvirt resolves `helios` for the Mac's ProxyJump; cpu-checker gives
# kvm-ok; cpio is engvm's; nftables loads the guard.
readonly PACKAGES='qemu-system-x86 qemu-utils libvirt-daemon-system libvirt-clients libnss-libvirt cpu-checker cpio nftables'
# The Ubuntu AMI ships Systems Manager's agent as a snap. The lab has no
# instance profile, but with SSM Default Host Management Configuration on
# for the account, the agent registers through IMDS alone, and Session
# Manager then reaches a shell past the /32 tcp/22 ingress rule (R10: the
# only way in), in sessions the idle check never counts. So the packages
# stage purges it, whatever the account's settings; its live check sees it
# come back. /snap/<name> exists exactly while snapd has the snap installed.
readonly SSM_SNAP=amazon-ssm-agent
readonly SSM_SNAP_DIR=$ROOT_PREFIX/snap/$SSM_SNAP

die() { printf '%s: %s\n' "$HOST_SELF" "$1" >&2; exit 1; }

# =============================================================================
# Pure functions (the Mac suite calls these directly)
# =============================================================================

# stage_decision <recorded input|""> <pushed input> -> run | skip
# A stage is skipped only when its marker records exactly the input the
# push brings; an absent marker, a different input, or (defensively) an
# empty pushed input all run it.
stage_decision() {
  if [[ -n $2 && $1 == "$2" ]]; then echo skip; else echo run; fi
}

# stage_spec <stage> [host.conf text] [engvm-lab.sh text] -> the text a
# stage's input hashes: everything it applies. The "rN" revision is bumped
# when a stage's code changes in a way its spec doesn't show, so hosts re-run
# it. engvm and seed take the pin from host.conf, engvm the sizing too; the
# guest stage has no input (it is never skipped), so it fails here.
stage_spec() {
  local pin
  case $1 in
    packages) printf 'packages r2: %s; snap remove --purge %s\n' "$PACKAGES" "$SSM_SNAP" ;;
    libvirt)  printf 'libvirt r1: %s in libvirt,kvm; %s; network default active+autostart; nss libvirt_guest\n' \
                "$LAB_USER" "$LIBVIRT_URI"
              libvirt_guests_conf ;;
    guard)    echo 'guard r1'; guard_ruleset; guard_unit ;;
    engvm)    pin=$(conf_get "${2:-}" ENGVM_PIN) || return 1
              printf 'engvm r1: %s @ %s in %s as %s; config/lab.sh:\n%s\n' \
                "$ENGVM_REPO" "$pin" "$ENGVM_HOME" "$LAB_USER" "${3:-}" ;;
    seed)     pin=$(conf_get "${2:-}" ENGVM_PIN) || return 1
              printf 'seed r1: download.sh @ %s as %s, timeout %ss\n' "$pin" "$LAB_USER" "$SEED_TIMEOUT_S" ;;
    *)        return 1 ;;
  esac
}

# spec_input <spec text> -> "sha256:<hex>", the value a marker records
spec_input() {
  local sum
  sum=$(printf '%s\n' "$1" | sha256_hex) || return 1
  [[ $sum =~ ^[0-9a-f]{64}$ ]] || return 1
  echo "sha256:$sum"
}

# sha256_hex — stdin's SHA-256 in hex (sha256sum on Ubuntu, shasum on a Mac)
sha256_hex() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1
  else shasum -a 256 | cut -d' ' -f1
  fi
}

# stage_input <stage> [host.conf text] [engvm-lab.sh text] -> the input the
# pushed code and config give that stage
stage_input() {
  local spec
  spec=$(stage_spec "$@") || return 1
  spec_input "$spec"
}

# progress_line <epoch> <name> <event> [message] -> one protocol line. The
# message is flattened to one line (control characters become spaces).
# Fails on a name or event outside the protocol: that is a bug, not data.
progress_line() {
  local msg=${4:-}
  [[ $1 =~ ^[0-9]+$ && $2 =~ ^[a-z][a-z0-9-]*$ ]] || return 1
  case $3 in start|done|skip|fail) ;; *) return 1 ;; esac
  msg=${msg//[[:cntrl:]]/ }
  printf '%s %s %s%s\n' "$1" "$2" "$3" "${msg:+ $msg}"
}

# install_dest <pushed file name> -> "<path> <mode>"; fails for a name with
# no rule, so a new host/ file can't land somewhere by accident
install_dest() {
  case $1 in
    helios-lab-host)                         echo "$LIBEXEC_DIR/$1 0755" ;;
    helios-lab-*.service|helios-lab-*.timer) echo "$SYSTEMD_DIR/$1 0644" ;;
    host.conf|engvm-lab.sh)                  echo "$CONF_DIR/$1 0644" ;;
    sshd-helios-lab.conf)                    echo "$SSHD_DROPIN 0644" ;;
    *)                                       return 1 ;;
  esac
}

# conf_get <host.conf text> <key> -> its value; fails when absent
conf_get() {
  local line
  while IFS= read -r line; do
    [[ $line != "$2="* ]] || { printf '%s\n' "${line#*=}"; return 0; }
  done <<< "$1"
  return 1
}

# conf_problem <host.conf text> -> what is wrong with it, or nothing. The Mac
# renders it (render_host_config); this guards against a stale or edited file.
conf_problem() {
  local line idle pin
  while IFS= read -r line; do
    case $line in
      ''|'#'*|IDLE_MINUTES=*|ENGVM_PIN=*) ;;
      *) echo "unexpected line: $line"; return 0 ;;
    esac
  done <<< "$1"
  idle=$(conf_get "$1" IDLE_MINUTES) || { echo 'IDLE_MINUTES is missing'; return 0; }
  pin=$(conf_get "$1" ENGVM_PIN) || { echo 'ENGVM_PIN is missing'; return 0; }
  idle_ok "$idle" || { echo "IDLE_MINUTES=$idle is not 5..720 in steps of 5"; return 0; }
  [[ $pin =~ ^[0-9a-f]{40}$ ]] || echo "ENGVM_PIN=$pin is not a full commit hash"
}

idle_ok() { [[ $1 =~ ^[1-9][0-9]{0,2}$ ]] && (( $1 % 5 == 0 && $1 <= 720 )); }

# show_value <`systemctl show` text> <n> <property> -> the property's value
# in the nth KEY=value block (blocks are one blank line apart), or unknown
show_value() {
  local line n=1 value=''
  while IFS= read -r line; do
    if [[ -z $line ]]; then n=$(( n + 1 ))
    elif (( n == $2 )) && [[ $line == "$3="* ]]; then value=${line#*=}
    fi
  done <<< "$1"
  echo "${value:-unknown}"
}

# lock_held <apt or dpkg output> -> 0 when it failed because another apt or
# dpkg run holds a lock (apt-daily on a first boot): the one failure the
# packages stage waits out. apt says "Could not get lock" or "Unable to
# acquire the dpkg frontend lock" or "Unable to lock directory"; dpkg says
# its "lock was locked by another process", or, before 1.21, its "status
# database is locked by another process".
lock_held() {
  case $1 in
    *'Could not get lock'*|*'Unable to acquire the dpkg frontend lock'*|*'Unable to lock directory'*|\
    *'locked by another process'*|*'database is locked'*) return 0 ;;
    *) return 1 ;;
  esac
}

# lock_budget_s <one try's own lock wait, s> -> the longest with_lock_retries
# waits out a held lock: LOCK_TRIES tries, each blocking up to that long,
# with LOCK_WAIT_S between them
lock_budget_s() { echo $(( LOCK_TRIES * $1 + (LOCK_TRIES - 1) * LOCK_WAIT_S )); }

# lock_exhausted <what> <one try's own lock wait, s> -> the packages stage's
# reason when every try found the lock held, with the true budget it spent
# (to the nearest minute)
lock_exhausted() {
  printf '%s found the lock held in %s tries, %ss apart, over about %s min: %s\n' "$1" "$LOCK_TRIES" \
    "$LOCK_WAIT_S" $(( ($(lock_budget_s "$2") + 30) / 60 )) 'another apt or dpkg run holds it (see the journal)'
}

# apt_said <apt or dpkg output> -> its own error line: the first "E: " or
# "dpkg: error" line, else its last non-blank line, else nothing
apt_said() {
  local line last=''
  while IFS= read -r line; do
    case $line in 'E: '*|'dpkg: error'*) printf '%s\n' "$line"; return 0 ;; esac
    [[ -z ${line//[[:space:]]/} ]] || last=$line
  done <<< "$1"
  printf '%s' "$last"
}

# unit_place <unit> -> its place in STATUS_UNITS, from 1; 0 when it is not there
unit_place() {
  local unit n=0
  for unit in $STATUS_UNITS; do
    n=$(( n + 1 ))
    [[ $unit != "$1" ]] || { echo "$n"; return 0; }
  done
  echo 0
}

# with_libvirt_guest <nsswitch.conf text> -> the same, with libvirt_guest on
# the hosts line (right after "files"), so the host resolves the guest's
# name `helios` from libvirt's leases. Unchanged when it is already there.
with_libvirt_guest() {
  local line re='^(hosts:[[:space:]]+files)([[:space:]].*)?$'
  while IFS= read -r line; do
    case $line in
      hosts:*libvirt_guest*) ;;
      hosts:*) if [[ $line =~ $re ]]; then line="${BASH_REMATCH[1]} libvirt_guest${BASH_REMATCH[2]}"
               else line="hosts: libvirt_guest ${line#hosts:}"
               fi ;;
    esac
    printf '%s\n' "$line"
  done <<< "$1"
}

# environment_with_uri <environment text> -> the same, with exactly one
# LIBVIRT_DEFAULT_URI line, the system one: engvm's create.sh runs as ubuntu
# and must reach qemu:///system, where the default network lives
environment_with_uri() {
  local line
  if [[ -n $1 ]]; then
    while IFS= read -r line; do
      [[ $line == LIBVIRT_DEFAULT_URI=* ]] || printf '%s\n' "$line"
    done <<< "$1"
  fi
  printf 'LIBVIRT_DEFAULT_URI=%s\n' "$LIBVIRT_URI"
}

# libvirt_guests_conf -> /etc/default/libvirt-guests: on host poweroff (stop,
# or the idle timer) shut the guest down gracefully, which Helios does on ACPI
# in about 20 s (U7); never start guests from here
libvirt_guests_conf() {
  printf '%s\n' '# helios-lab (helios-lab-host, libvirt stage): shut guests down gracefully' \
    '# on host poweroff; never start them from here.' 'ON_BOOT=ignore' 'ON_SHUTDOWN=shutdown' 'SHUTDOWN_TIMEOUT=120'
}

# guard_ruleset -> /etc/helios-lab/guard.nft: forwarded traffic from the
# libvirt bridge to 169.254.0.0/16 is dropped, so the guest can't reach IMDS
# even if the hop limit ever regresses (R10). One transaction: create the
# table if missing, delete it, recreate it whole. Loading it again is
# therefore idempotent, and a half-applied earlier load can't leave a table
# without its chain. The chain is not named "fwd": that is an nft keyword.
# Validated on the U7 host. iifname matches by name, so it loads before
# virbr0 exists.
guard_ruleset() {
  cat <<'EOF'
# helios-lab guard (helios-lab-host, guard stage): drop guest traffic to the
# link-local range, which holds the instance metadata service.
table inet helios_lab_guard
delete table inet helios_lab_guard
table inet helios_lab_guard {
  chain forward_guard {
    type filter hook forward priority -10; policy accept;
    iifname "virbr0" ip daddr 169.254.0.0/16 drop
  }
}
EOF
}

# guard_unit -> helios-lab-guard.service: loads the ruleset on every boot,
# early (the pattern of Debian's nftables.service). libvirtd REQUIRES it and
# starts after it, so no guest ever runs without it: if the load fails,
# libvirtd fails too (fail closed), until the next up re-runs the guard stage.
# No ExecStop: the rules stay until poweroff. Debian's own nftables.service
# is not used: its config starts with "flush ruleset".
guard_unit() {
  printf '%s\n' '[Unit]' \
    'Description=helios-lab guard: drop guest traffic from virbr0 to 169.254.0.0/16' \
    'DefaultDependencies=no' 'Wants=network-pre.target' 'Before=network-pre.target libvirtd.service' '' \
    '[Service]' 'Type=oneshot' 'RemainAfterExit=yes' "ExecStart=/usr/sbin/nft -f $GUARD_RULES" '' \
    '[Install]' 'WantedBy=sysinit.target' 'RequiredBy=libvirtd.service'
}

# --- Guest (pure) ------------------------------------------------------------
# lab_sizing <engvm-lab.sh text> -> "3 vCPU, 8 GiB, 60G": the canonical
# sizing, which a guest record keeps and a mismatch compares. Fails unless
# the text sets VCPU, MEM and SIZE in the shipped forms and nothing else
# (comments and blank lines aside): create.sh sources the file, so nothing
# else may ride along, and a value it can't size a guest with fails here,
# before any stage runs.
readonly LAB_MEM_RE='^MEM=\$\(\( ([1-9][0-9]*) \* 1024 \* 1024 \)\)$'
lab_sizing() {
  local line vcpu='' mem='' size=''
  while IFS= read -r line; do
    case $line in
      ''|'#'*) ;;
      VCPU=*)  vcpu=${line#VCPU=} ;;
      MEM=*)   [[ $line =~ $LAB_MEM_RE ]] || return 1
               mem=${BASH_REMATCH[1]} ;;
      SIZE=*)  size=${line#SIZE=} ;;
      *)       return 1 ;;
    esac
  done <<< "$1"
  [[ $vcpu =~ ^[1-9][0-9]?$ && -n $mem && $size =~ ^[1-9][0-9]{0,3}G$ ]] || return 1
  echo "$vcpu vCPU, $mem GiB, $size"
}

# guest_action <verified: yes|no> <domain state> <create unit ActiveState>
# -> keep | start | lost | odd | wait | create: the single-marker protocol.
# <domain state> is virsh domstate's ("running", "shut off", ...), or absent
# or unknown (domstate_of). Invariant: with the marker, the answer is never
# create: a verified guest is only ever kept, started, or reported.
guest_action() {
  case $1:$2 in
    yes:running)                 echo keep ;;
    'yes:shut off'|yes:crashed)  echo start ;;
    yes:absent)                  echo lost ;;
    yes:*)                       echo odd ;;
    no:*) case $3 in
            active|activating)   echo wait ;;
            *)                   echo create ;;
          esac ;;
    *)                           return 1 ;;
  esac
}

# guest_record <pin> <sizing> -> guest.built and guest-verified: what a guest
# was created from, as KEY=value lines (read back with conf_get)
guest_record() { printf 'ENGVM_PIN=%s\nSIZING=%s\n' "$1" "$2"; }

# record_field <record text> <ENGVM_PIN|SIZING> -> its value, or ? when unreadable
record_field() { conf_get "$1" "$2" || echo '?'; }

# kept_note <verified record> <pushed pin> <pushed sizing> -> the guest
# stage's note when a verified guest was built from something else than the
# push brings; nothing when they agree
kept_note() {
  local pin sizing
  pin=$(record_field "$1" ENGVM_PIN)
  sizing=$(record_field "$1" SIZING)
  [[ $pin != "$2" || $sizing != "$3" ]] || return 0
  echo "built from engvm @${pin:0:7}, $sizing, not the pushed @${2:0:7}, $3: kept, only a re-create applies it"
}

# seed_verdict <download.sh exit status, under timeout> -> ok | timeout | failed
# timeout(1) exits 124 when it had to stop the command: download.sh itself
# never gives up on a failing curl.
seed_verdict() {
  case $1 in
    0)   echo ok ;;
    124) echo timeout ;;
    *)   echo failed ;;
  esac
}

# domstate_of <virsh domstate exit status> <its output> -> the state
# ("running", "shut off", ...), absent when libvirt has no such domain, or
# unknown when libvirt could not say (not installed, or not answering)
domstate_of() {
  local line
  if (( $1 == 0 )); then
    while IFS= read -r line; do
      [[ -z ${line// /} ]] || { printf '%s\n' "$line"; return 0; }
    done <<< "$2"
    echo unknown
    return 0
  fi
  case $2 in
    *'failed to get domain'*|*'Domain not found'*) echo absent ;;
    *)                                             echo unknown ;;
  esac
}

# console_clean <transcript text> -> its readable lines: each line as the
# terminal last showed it (the text after its last carriage return), with
# escape sequences and other control characters removed and the ends
# trimmed; blank lines are dropped. `script` records the raw serial console:
# CRLF line ends, progress redrawn in place, the loader's escape sequences.
readonly CSI_RE=$'\e''\[[0-9;?]*[ -/]*[@-~]'
console_clean() {
  local line
  while IFS= read -r line || [[ -n $line ]]; do
    while [[ $line == *$'\r' ]]; do line=${line%$'\r'}; done
    line=${line##*$'\r'}
    while [[ $line =~ $CSI_RE ]]; do line=${line/"${BASH_REMATCH[0]}"/}; done
    line=${line//[[:cntrl:]]/}
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    [[ -z $line ]] || printf '%s\n' "$line"
  done <<< "$1"
}

# --- Idle (pure) -------------------------------------------------------------
# The rule (plan: "Idle auto-stop"): the host is idle when no session is
# established on its :22 and no keep is in force. Guest ssh (ProxyJump) and
# the console both end at the host's sshd, so the session count covers every
# way in. An ACTIVE provision run also holds the host up, for at most
# PROVISION_DEFER_S. There is no load input. Every IDLE_TICK_S one check
# runs (helios-lab-idle.timer): busy resets the count, idle adds one, and
# the check that makes the count reach the window's checks (IDLE_MINUTES / 5)
# powers the host off.
# Invariants (the decision table in tests/idle.test.sh checks each):
# - fail closed: an input the check can't use never resets the count; it
#   counts as idle, so a broken check ends in a stop, not in unbounded billing
# - a failed or hung provision holds the host up for at most 2h: only an
#   active run defers, and only while it is younger than PROVISION_DEFER_S
# - absent sessions and keeps, the host always becomes stoppable: those two
#   and the bounded provision clause are the only holds (idle_busy)
# - a keep holds it for at most KEEP_MAX_S (plus one check's slack)
# - the idle path only powers off: the instance's shutdown behaviour is stop
#   (U6), so it stops the host but can never terminate it
readonly IDLE_TICK_S=300           # helios-lab-idle.timer's OnUnitActiveSec
readonly PROVISION_DEFER_S=7200
readonly KEEP_MAX_S=43200          # keep's cap, 12h (the Mac checks it too)
readonly KEEP_SLACK_S=300          # for a clock step after a keep was written
readonly IDLE_FALLBACK_TICKS=12    # the default 60 min, when host.conf is unusable
readonly NUM_RE='^(0|[1-9][0-9]{0,11})$'   # a plain count or epoch: no sign, no leading 0

# inhibit_state <now|?> <inhibit-until text|none> -> <deadline> | none | invalid
# The keep in force: its deadline while it lies ahead; none when there is no
# keep or it has passed. Anything else is invalid, a deadline beyond the cap
# included: a hand-edited or clock-skewed keep is never trusted to hold the
# host up. The idle check and status both judge a keep only through here.
inhibit_state() {
  [[ $2 != none ]] || { echo none; return 0; }
  [[ $1 =~ $NUM_RE && $2 =~ $NUM_RE ]] || { echo invalid; return 0; }
  if (( $2 > $1 + KEEP_MAX_S + KEEP_SLACK_S )); then echo invalid
  elif (( $2 > $1 )); then echo "$2"
  else echo none
  fi
}

# provision_defers <ActiveState> <active seconds> -> 0 while an active run is
# younger than PROVISION_DEFER_S. Only "active" (Type=exec: exactly while
# stages run); a failed, finished or never-started run defers nothing.
provision_defers() { [[ $1 == active ]] && (( $2 < PROVISION_DEFER_S )); }

# The decision's inputs, in this order; "?" is an input the check could not
# read, and <active seconds> is "-" when the provision unit is not active:
#   <provision ActiveState> <active seconds> <now> <inhibit-until|none>
#   <sessions on :22> <count: idle checks so far> <required: IDLE_MINUTES / 5>

# idle_problems <inputs...> -> the inputs it cannot use, comma-separated;
# nothing when every one is usable
idle_problems() {
  local -a bad=()
  [[ $1 =~ ^[a-z][a-z-]*$ ]] || bad+=('the provision unit')
  [[ $1 != active || $2 =~ $NUM_RE ]] || bad+=("the provision run's age")
  [[ $3 =~ $NUM_RE ]] || bad+=('the clock')
  [[ $(inhibit_state "$3" "$4") != invalid ]] || bad+=('the keep deadline')
  [[ $5 =~ $NUM_RE ]] || bad+=('the ssh sessions')
  [[ $6 =~ $NUM_RE ]] || bad+=('the idle count')
  [[ $7 =~ ^[1-9][0-9]{0,3}$ ]] || bad+=('the idle window')
  (( ${#bad[@]} == 0 )) || join_comma "${bad[@]}"
}

join_comma() {
  local out=$1
  shift
  while (( $# > 0 )); do out="$out, $1"; shift; done
  printf '%s\n' "$out"
}

# idle_decision <inputs...> -> reset | increment | poweroff
# Busy resets, but only when every input is usable (fail closed). Otherwise
# this check makes the count count + 1, and powers off once that reaches
# required: with required 12, the check after 11 idle ones powers off.
idle_decision() {
  if [[ -z $(idle_problems "$@") ]] && idle_busy "$@"; then echo reset; return 0; fi
  if (( $(idle_count_of "$6") + 1 >= $(idle_required_of "$7") )); then echo poweroff; else echo increment; fi
}

# idle_busy <inputs, all usable...> -> 0 when something holds the host up
idle_busy() {
  provision_defers "$1" "$2" || [[ $(inhibit_state "$3" "$4") =~ $NUM_RE ]] || (( $5 > 0 ))
}

# idle_count_of <count|?> / idle_required_of <required|?> -> the value the
# decision uses: an unusable count starts again at 0, an unusable window is
# the default one
idle_count_of() { if [[ $1 =~ $NUM_RE ]]; then echo "$1"; else echo 0; fi; }
idle_required_of() { if [[ $1 =~ ^[1-9][0-9]{0,3}$ ]]; then echo "$1"; else echo "$IDLE_FALLBACK_TICKS"; fi; }

# idle_next_count <decision> <count|?> -> the count this check leaves
idle_next_count() {
  case $1 in
    reset) echo 0 ;;
    *)     echo $(( $(idle_count_of "$2") + 1 )) ;;
  esac
}

# idle_escalate <decision> <recorded: yes|no> -> the decision to act on. A
# count that could not be recorded can't reach the window, so an idle check
# that can't record powers off now (fail closed); a reset stays a reset.
idle_escalate() {
  if [[ $1 == reset || $2 == yes ]]; then echo "$1"; else echo poweroff; fi
}

# idle_record <now|?> <decision> <count> <required> [problem] -> the line the
# check leaves in /run/helios-lab/idle, which status reports and the next
# check reads its count from:
#   <epoch> <reset|increment|poweroff> <count> <required> [<problem>]
idle_record() { printf '%s %s %s %s%s\n' "$1" "$2" "$3" "$4" "${5:+ $5}"; }

# idle_record_count <record|none|?> -> its count: 0 for none (a fresh boot),
# ? for a record it can't read
idle_record_count() {
  local epoch decision count rest
  [[ $1 != none ]] || { echo 0; return 0; }
  read -r epoch decision count rest <<< "$1"
  if [[ $count =~ $NUM_RE ]]; then echo "$count"; else echo '?'; fi
}

# idle_required <host.conf text> -> the window in checks, IDLE_MINUTES / 5, or ?
idle_required() {
  local minutes
  if minutes=$(conf_get "$1" IDLE_MINUTES) && idle_ok "$minutes"; then
    echo $(( minutes * 60 / IDLE_TICK_S ))
  else
    echo '?'
  fi
}

# active_seconds <ActiveEnterTimestampMonotonic, µs> <`/proc/uptime` text>
# -> how long the provision run has been active; fails when either is
# unreadable. systemd's stamp is CLOCK_MONOTONIC and uptime CLOCK_BOOTTIME,
# which runs ahead only while the machine is suspended: never on EC2 without
# hibernation, and any difference makes a run look older, never younger,
# so it can only end the deferral sooner (fail closed). A wall-clock step
# can't move either.
active_seconds() {
  local up=${2%% *}
  up=${up%%.*}
  [[ $1 =~ ^[1-9][0-9]{0,15}$ && $up =~ $NUM_RE ]] || return 1
  (( up >= $1 / 1000000 )) || return 1
  echo $(( up - $1 / 1000000 ))
}

# count_lines <text> -> its non-empty lines
count_lines() {
  local n=0 line
  while IFS= read -r line; do [[ -z $line ]] || n=$(( n + 1 )); done <<< "$1"
  echo "$n"
}

# keep_until <now> <seconds> -> the keep's deadline, now + seconds; fails
# outside 1..KEEP_MAX_S. The deadline is taken on the host's clock, the one
# the idle check compares it with, and the cap is enforced here as well as
# on the Mac: no keep can hold the host up for longer.
keep_until() {
  [[ $1 =~ $NUM_RE && $2 =~ ^[1-9][0-9]{0,4}$ ]] && (( $2 <= KEEP_MAX_S )) || return 1
  echo $(( $1 + $2 ))
}

# =============================================================================
# Effects
# =============================================================================

# progress <name> <event> [message] — one protocol line, to the progress
# file and to stdout (the unit's journal)
progress() {
  local line
  line=$(progress_line "$(date +%s)" "$@") || die "bad progress event: $*"
  mkdir -p "$MARKER_DIR"
  printf '%s\n' "$line" >> "$PROGRESS_FILE"
  printf '%s\n' "$line"
}

marker_read() { cat "$MARKER_DIR/stage.$1" 2>/dev/null || true; }

# marker_write <stage> <input> — only after the stage succeeded; atomic
marker_write() {
  mkdir -p "$MARKER_DIR"
  printf '%s\n' "$2" > "$MARKER_DIR/stage.$1.new"
  mv -f "$MARKER_DIR/stage.$1.new" "$MARKER_DIR/stage.$1"
}

# write_file <path> <content> <mode> — replaced atomically (rename), so a
# reader, or a bash still running the old file, never sees half of it
write_file() {
  mkdir -p "${1%/*}" && printf '%s\n' "$2" > "$1.new" && chmod "$3" "$1.new" && mv -f "$1.new" "$1"
}

# stage_fail <reason> — inside a stage: the reason goes to fd 3, which
# run_stage reads, and the stage's subshell exits
stage_fail() { printf '%s\n' "$1" >&3; exit 1; }

# run_stage <stage> <host.conf text> <engvm-lab.sh text> — skip it or apply
# it, per its marker. A marker is trusted only while the stage's live check
# passes. The guest stage is always applied: guest-verified, not a stage
# marker, decides what it does (single-marker protocol, header).
run_stage() {
  local input recorded
  if [[ $1 == guest ]]; then apply_stage guest '' "$2"; return; fi
  input=$(stage_input "$1" "$2" "$3") || return 1
  recorded=$(marker_read "$1")
  if [[ -n $recorded ]] && ! "check_$1" "$2"; then recorded=''; fi
  case $(stage_decision "$recorded" "$input") in
    skip) progress "$1" skip ;;
    run)  apply_stage "$1" "$input" "$2" ;;
  esac
}

# apply_stage <stage> <input|""> <host.conf text> — runs stage_<stage>
# (given host.conf) in a subshell. Its stdout and stderr go to the journal;
# the last line it writes to fd 3 is its summary (done) or reason (fail). The
# marker is written only on success, and only for a stage with an input.
apply_stage() {
  local summary rc=0
  progress "$1" start
  { summary=$("stage_$1" "$3" 3>&1 1>&4) || rc=$?; } 4>&1
  summary=${summary##*$'\n'}
  if (( rc != 0 )); then
    progress "$1" fail "${summary:-exited $rc; see the journal}"
    return 1
  fi
  [[ -z $2 ]] || marker_write "$1" "$2"
  progress "$1" 'done' "$summary"
}

# provision_run — the stages, in order, framed by "provision start" and
# "provision done"; the first failing stage ends the run. Both pushed files
# are checked before any stage runs.
provision_run() {
  local conf lab why stage
  progress provision start
  conf=$(cat "$CONF_FILE" 2>/dev/null) || conf=''
  if [[ -z $conf ]]; then why='missing or empty'; else why=$(conf_problem "$conf"); fi
  if [[ -n $why ]]; then
    progress provision fail "bad host config $CONF_FILE: $why; run helios-lab up"
    return 1
  fi
  lab=$(cat "$LAB_CONF_FILE" 2>/dev/null) || lab=''
  if ! lab_sizing "$lab" >/dev/null; then
    progress provision fail "bad guest sizing $LAB_CONF_FILE: not the VCPU, MEM and SIZE lines engvm-lab.sh ships; run helios-lab up"
    return 1
  fi
  for stage in $STAGES; do
    run_stage "$stage" "$conf" "$lab" || { progress provision fail "$stage"; return 1; }
  done
  progress provision 'done'
}

# cmd_provision — the unit's ExecStart. The lock keeps a run started by hand
# from overlapping the unit's.
cmd_provision() {
  require_root provision
  mkdir -p "${PROVISION_LOCK%/*}"
  exec 9>"$PROVISION_LOCK"
  flock -n 9 || die 'another provision run holds the lock; start provisioning only through the unit'
  provision_run
}

# --- Stages ------------------------------------------------------------------
# Each runs in a subshell without errexit, so every step states its own
# failure with stage_fail. What a stage writes to fd 3 last is its summary.

# apt_get — no prompt can be answered here (StandardInput=null): a conffile
# this helper edited (/etc/default/libvirt-guests) keeps the local version
# when an upgrade ships a new one, instead of asking. DPkg::Lock::Timeout
# lets apt itself wait for dpkg's frontend lock, but only APT_LOCK_WAIT_S:
# short, so with_lock_retries' loop, not apt, governs how long a held lock
# is waited out (lock_budget_s).
readonly APT_LOCK_WAIT_S=15
apt_get() {
  apt-get -o "DPkg::Lock::Timeout=$APT_LOCK_WAIT_S" -o Dpkg::Options::=--force-confdef \
    -o Dpkg::Options::=--force-confold -q "$@"
}

# with_lock_retries <what> <its own lock wait, s> <command...> — inside a
# stage: runs the command, then passes its output (stderr joined in) on to
# the journal, so it can be read for a held lock. A failure that says a lock
# is held (lock_held) is tried again, up to LOCK_TRIES times LOCK_WAIT_S
# apart; any other failure fails the stage at once, with apt's own error
# line (apt_said). <its own lock wait> is how long one try may block on a
# lock before it fails: APT_LOCK_WAIT_S for apt_get (DPkg::Lock::Timeout
# covers only dpkg's frontend lock; `apt-get update`'s lists lock fails at
# once), 0 for dpkg, which fails at once while another apt holds its lock
# (apt-daily, on a first boot). The longest a held lock keeps a call here
# is lock_budget_s of it, which the exhaustion message states.
readonly LOCK_TRIES=30 LOCK_WAIT_S=10
with_lock_retries() {
  local what=$1 own=$2 n out rc said
  shift 2
  for (( n = 1; ; n++ )); do
    rc=0
    out=$("$@" 2>&1) || rc=$?
    [[ -z $out ]] || printf '%s\n' "$out"
    (( rc != 0 )) || return 0
    said=$(apt_said "$out")
    lock_held "$out" || stage_fail "$what failed (exit $rc)${said:+: $said}"
    (( n < LOCK_TRIES )) || stage_fail "$(lock_exhausted "$what" "$own")"
    sleep "$LOCK_WAIT_S"
  done
}

stage_packages() {
  local removed=''
  # needrestart only asks about services on upgraded libraries, and this
  # installs new packages: it sits out
  export DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1
  # A first boot may still be running cloud-init, which can hold apt.
  timeout 600 cloud-init status --wait >/dev/null 2>&1 || echo 'cloud-init did not report done; continuing'
  # The way in past the ingress rule goes first, before anything apt may fail on.
  if [[ -e $SSM_SNAP_DIR ]]; then ssm_agent_remove; removed=" · $SSM_SNAP removed"; fi
  # Finishes a dpkg run that a stop interrupted (`stop` mid-apt).
  with_lock_retries 'dpkg --configure -a' 0 dpkg --configure -a
  with_lock_retries 'apt-get update' "$APT_LOCK_WAIT_S" apt_get update
  # shellcheck disable=SC2086  # the list is one word per package
  with_lock_retries 'apt-get install' "$APT_LOCK_WAIT_S" apt_get -y install $PACKAGES
  echo "$(wc -w <<< "$PACKAGES" | tr -d ' ') packages installed$removed" >&3
}

# ssm_agent_remove — inside the packages stage, once /snap/amazon-ssm-agent
# shows the snap installed (a host without it, or without snapd, has nothing
# to remove, so the stage is idempotent): purged with its data, no snapshot
# kept (SSM_SNAP says why). snapd refuses a remove until a first boot has
# seeded its snaps, so that is waited for, bounded.
ssm_agent_remove() {
  timeout 300 snap wait system seed.loaded || echo "snapd did not report its snaps seeded; removing $SSM_SNAP anyway"
  snap remove --purge "$SSM_SNAP" \
    || stage_fail "cannot remove the $SSM_SNAP snap (see the journal): with SSM Default Host Management it is a way in past the ssh ingress rule"
  [[ ! -e $SSM_SNAP_DIR ]] || stage_fail "the $SSM_SNAP snap is still installed after snap remove --purge (see the journal)"
}

# Live checks capture their tool's output before matching it: a `| grep -q`
# under pipefail could fail a passing check when grep exits early. The SSM
# agent back (reinstalled by hand, say) fails it too, so the stage runs again.
# shellcheck disable=SC2016,SC2086  # dpkg-query's own ${Status}; one word per package
check_packages() {
  local status want have
  [[ ! -e $SSM_SNAP_DIR ]] || return 1
  status=$(dpkg-query -W -f='${Status}\n' $PACKAGES 2>/dev/null) || return 1
  want=$(wc -w <<< "$PACKAGES")
  have=$(grep -c '^install ok installed$' <<< "$status") || have=0
  (( have == want ))
}

stage_libvirt() {
  kvm_usable || stage_fail 'no usable /dev/kvm: the instance needs nested virtualization (NestedVirtualization=enabled on a supported type)'
  usermod -aG libvirt,kvm "$LAB_USER" || stage_fail "cannot add $LAB_USER to the libvirt and kvm groups"
  rewrite "$ROOT_PREFIX/etc/environment" environment_with_uri || stage_fail 'cannot set LIBVIRT_DEFAULT_URI in /etc/environment'
  rewrite "$ROOT_PREFIX/etc/nsswitch.conf" with_libvirt_guest || stage_fail 'cannot add libvirt_guest to /etc/nsswitch.conf'
  grep -Eq '^hosts:.*[[:space:]]libvirt_guest([[:space:]]|$)' "$ROOT_PREFIX/etc/nsswitch.conf" \
    || stage_fail 'the nsswitch hosts line still lacks libvirt_guest'
  write_file "$ROOT_PREFIX/etc/default/libvirt-guests" "$(libvirt_guests_conf)" 0644 \
    || stage_fail 'cannot write /etc/default/libvirt-guests'
  systemctl enable --now libvirt-guests.service || stage_fail 'cannot enable libvirt-guests.service'
  virsh_sys net-autostart default || stage_fail 'cannot autostart the default network'
  net_active || virsh_sys net-start default || stage_fail 'cannot start the default network'
  echo 'kvm ok, default network active' >&3
}

check_libvirt() { kvm_usable && net_active; }

kvm_usable() { [[ -c /dev/kvm ]] && kvm-ok >/dev/null 2>&1; }
virsh_sys() { virsh -c "$LIBVIRT_URI" "$@"; }

net_active() {
  local info key value
  info=$(virsh_sys net-info default 2>/dev/null) || return 1
  while read -r key value; do
    [[ $key != Active: ]] || { [[ $value == yes ]]; return; }
  done <<< "$info"
  return 1
}

# rewrite <file> <transform> — the file through a pure transform, in place
rewrite() {
  local text new
  text=$(cat "$1") || return 1
  new=$("$2" "$text") || return 1
  write_file "$1" "$new" 0644
}

# The ruleset loads here with nft -f itself, never by restarting the unit:
# libvirtd requires the unit, so a restart would restart libvirtd too. The
# start only marks a freshly enabled unit active (a no-op once it is).
stage_guard() {
  write_file "$ROOT_PREFIX$GUARD_RULES" "$(guard_ruleset)" 0644 || stage_fail "cannot write $GUARD_RULES"
  write_file "$SYSTEMD_DIR/$GUARD_SERVICE" "$(guard_unit)" 0644 || stage_fail "cannot write $GUARD_SERVICE"
  systemctl daemon-reload || stage_fail 'systemctl daemon-reload failed'
  systemctl enable "$GUARD_SERVICE" || stage_fail "cannot enable $GUARD_SERVICE"
  nft -f "$ROOT_PREFIX$GUARD_RULES" || stage_fail "loading $GUARD_RULES failed (nft -f): see the journal"
  systemctl start "$GUARD_SERVICE" || stage_fail "cannot start $GUARD_SERVICE"
  check_guard || stage_fail 'the guard chain is not loaded after nft -f'
  echo 'virbr0 to 169.254.0.0/16 dropped' >&3
}

check_guard() {
  local chain
  systemctl is-enabled --quiet "$GUARD_SERVICE" || return 1
  chain=$(nft list chain inet helios_lab_guard forward_guard 2>/dev/null) || return 1
  [[ $chain == *'iifname "virbr0" ip daddr 169.254.0.0/16 drop'* ]]
}

# as_lab <command...> — as ubuntu, with its HOME, groups and login shell
# variables (runuser sets them), so git sees a checkout of its own owner
as_lab() { runuser -u "$LAB_USER" -- "$@"; }

# as_lab_virsh <command...> — as ubuntu, against the system libvirt, where
# the default network lives (engvm's scripts call plain `virsh`)
as_lab_virsh() { as_lab env "LIBVIRT_DEFAULT_URI=$LIBVIRT_URI" "$@"; }

lab_conf_text() { cat "$LAB_CONF_FILE" 2>/dev/null || true; }

# engvm: the checkout at exactly the pin (R6: unmodified, so the checkout is
# forced), then the lab sizing as config/lab.sh, which engvm's .gitignore
# keeps out of its tree. A directory that is not a checkout is never removed
# here: it may hold the downloaded seed.
stage_engvm() {
  local pin head
  pin=$(conf_get "$1" ENGVM_PIN) || stage_fail 'host.conf has no ENGVM_PIN'
  if [[ ! -e $ENGVM_DIR ]]; then
    as_lab git clone --quiet "$ENGVM_REPO" "$ENGVM_DIR" || stage_fail "cannot clone $ENGVM_REPO (see the journal)"
  fi
  [[ -d $ENGVM_DIR/.git ]] || stage_fail "$ENGVM_HOME is not a git checkout: remove it (helios-lab ssh host sudo rm -rf $ENGVM_HOME, which also drops the seed), then helios-lab up"
  as_lab git -C "$ENGVM_DIR" cat-file -e "$pin^{commit}" 2>/dev/null \
    || as_lab git -C "$ENGVM_DIR" fetch --quiet origin || stage_fail "cannot fetch $ENGVM_REPO (see the journal)"
  as_lab git -C "$ENGVM_DIR" checkout --quiet --force --detach "$pin" \
    || stage_fail "cannot check out $pin: is it a commit of $ENGVM_REPO?"
  head=$(as_lab git -C "$ENGVM_DIR" rev-parse HEAD) || head=''
  [[ $head == "$pin" ]] || stage_fail "the checkout's HEAD is ${head:-unreadable}, not the pin $pin"
  install -o "$LAB_USER" -g "$LAB_USER" -m 0644 "$LAB_CONF_FILE" "$ENGVM_DIR/config/lab.sh" \
    || stage_fail "cannot install $ENGVM_HOME/config/lab.sh"
  echo "@${pin:0:7} · lab: $(lab_sizing "$(lab_conf_text)")" >&3
}

check_engvm() {
  local pin head
  pin=$(conf_get "$1" ENGVM_PIN) || return 1
  head=$(as_lab git -C "$ENGVM_DIR" rev-parse HEAD 2>/dev/null) || return 1
  [[ $head == "$pin" ]] && cmp -s "$LAB_CONF_FILE" "$ENGVM_DIR/config/lab.sh"
}

# seed: download.sh at the pin, which pins the seed's URL and both checksums
# itself (plan: Open Questions), resumes a partial download and verifies what
# it has. It retries forever on a failing curl, so the stage bounds it, and a
# timeout is a named failure. It runs inside the provision unit, which an up
# disconnecting (Ctrl-C, a sleeping Mac) never stops.
stage_seed() {
  local rc=0
  [[ -x $ENGVM_DIR/download.sh ]] || stage_fail "$ENGVM_HOME/download.sh is missing: the engvm stage has not run"
  timeout "$SEED_TIMEOUT_S" runuser -u "$LAB_USER" -- "$ENGVM_DIR/download.sh" || rc=$?
  case $(seed_verdict "$rc") in
    timeout) stage_fail "seed download timed out after $(( SEED_TIMEOUT_S / 60 )) min (download.sh retries forever; pkg.oxide.computer may be slow or unreachable): helios-lab up resumes it" ;;
    failed)  stage_fail "download.sh failed (exit $rc): see the journal" ;;
  esac
  check_seed || stage_fail "download.sh finished, but $ENGVM_HOME/input/$SEED_IMAGE is missing"
  echo "verified against engvm's pinned checksums" >&3
}

check_seed() { [[ -f $ENGVM_DIR/input/$SEED_IMAGE ]]; }

# guest: the single-marker protocol (header). Returns once the domain runs;
# the Mac's smoke check decides whether the guest is good.
stage_guest() {
  local verified=no domain create pin sizing note=''
  [[ ! -f $GUEST_VERIFIED ]] || verified=yes
  domain=$(domain_state)
  create=$(unit_property ActiveState "$CREATE_UNIT")
  pin=$(conf_get "$1" ENGVM_PIN) || stage_fail 'host.conf has no ENGVM_PIN'
  sizing=$(lab_sizing "$(lab_conf_text)") || stage_fail "$LAB_CONF_FILE does not size a guest"
  [[ $verified == no ]] || note=$(kept_note "$(cat "$GUEST_VERIFIED")" "$pin" "$sizing")
  case $(guest_action "$verified" "$domain" "$create") in
    keep)   guest_autostart
            echo "verified guest running${note:+ · $note}" >&3 ;;
    start)  guest_autostart
            virsh_sys start "$GUEST_VM" || stage_fail "cannot start the verified guest (it was $domain)"
            echo "verified guest started${note:+ · $note}" >&3 ;;
    lost)   stage_fail "guest-verified exists, but libvirt has no domain $GUEST_VM: to build a new guest, helios-lab ssh host sudo rm /var/lib/helios-lab/guest-verified, then helios-lab up" ;;
    odd)    stage_fail "the verified guest is $domain, neither running nor shut off: helios-lab console shows it, and helios-lab up tries again" ;;
    wait)   guest_wait_running
            echo 'first boot under way (its create unit is still running)' >&3 ;;
    create) guest_create "$pin" "$sizing"
            guest_wait_running
            echo 'created · first boot under way' >&3 ;;
  esac
}

# guest_create <pin> <sizing> — engvm's destroy.sh (idempotent: it clears an
# earlier, unverified guest), then create.sh as ubuntu in a transient unit,
# under `script` for the pty create.sh's `virsh start --console` needs and
# for the console transcript. reset-failed and --collect: a failed run never
# blocks the unit's name for the next one. The unit owns the console until
# the Mac's guest-verified stops it; stopping it leaves the domain running.
guest_create() {
  install -d -o "$LAB_USER" -g "$LAB_USER" -m 0755 "$LOG_DIR" || stage_fail "cannot create $LOG_DIR"
  as_lab_virsh "$ENGVM_DIR/destroy.sh" lab || stage_fail "engvm's destroy.sh lab failed (see the journal)"
  write_file "$GUEST_BUILT" "$(guest_record "$1" "$2")" 0644 || stage_fail "cannot write $GUEST_BUILT"
  systemctl reset-failed "$CREATE_UNIT" >/dev/null 2>&1 || true   # nothing to reset is fine
  systemd-run --quiet --uid="$LAB_USER" --collect --unit="${CREATE_UNIT%.service}" \
    -E "LIBVIRT_DEFAULT_URI=$LIBVIRT_URI" -p "WorkingDirectory=$ENGVM_DIR" \
    /usr/bin/script -qfec './create.sh lab' "$TRANSCRIPT" || stage_fail "systemd-run could not start $CREATE_UNIT"
}

# guest_wait_running — until the domain runs; fails when the create unit
# ends first (create.sh failed), or at CREATE_WAIT_S
guest_wait_running() {
  local n
  for (( n = 0; n * 5 < CREATE_WAIT_S; n++ )); do
    [[ $(domain_state) != running ]] || return 0
    case $(unit_property ActiveState "$CREATE_UNIT") in
      active|activating) ;;
      *) stage_fail "create.sh ended before the guest ran: $(transcript_lines 1) (transcript: /var/log/helios-lab/console.log)" ;;
    esac
    sleep 5
  done
  stage_fail "the guest was not running $(( CREATE_WAIT_S / 60 )) min after create.sh started (transcript: /var/log/helios-lab/console.log)"
}

guest_autostart() { virsh_sys autostart "$GUEST_VM" >/dev/null || stage_fail "cannot mark $GUEST_VM to autostart"; }

# domain_state -> the guest domain's state (domstate_of)
domain_state() {
  local out rc=0
  out=$(virsh_sys domstate "$GUEST_VM" 2>&1) || rc=$?
  domstate_of "$rc" "$out"
}

# transcript_lines <n> -> the console transcript's last n readable lines
transcript_lines() {
  local raw
  [[ -f $TRANSCRIPT ]] || return 0
  raw=$(tail -n 400 "$TRANSCRIPT" 2>/dev/null) || return 0
  console_clean "$raw" | tail -n "$1"
}

# --- install, progress, journal ----------------------------------------------
# cmd_install <dir> — the push's last step, as root: each pushed file to its
# place (install_dest), atomically, then a systemd reload, sshd's drop-in
# applied, and the stop handed from the dead-man timer to the idle timer.
# Every push also restarts the idle window (idle_window_restart). The
# directory goes afterwards; only one named like the push's own is ever
# removed. Any failure dies before the handoff completes, so up fails loudly
# and whatever stop was armed stays armed.
cmd_install() {
  local stage=${1:-} f spec dest mode
  require_root install
  [[ -d $stage && ${stage##*/} == helios-lab-push.* ]] || die "install takes the push's directory, not '$stage'"
  for f in "$stage"/*; do
    [[ -f $f ]] || continue
    spec=$(install_dest "${f##*/}") || die "no install rule for ${f##*/}"
    read -r dest mode <<< "$spec"
    write_file "$dest" "$(<"$f")" "$mode" || die "cannot install $dest"
  done
  systemctl daemon-reload || die 'systemctl daemon-reload failed'
  sshd_apply
  idle_window_restart
  idle_arm
  rm -rf "$stage"
  # The install's epoch, on the host's clock: up re-runs a provision that
  # was already active and so began before this push (lib/remote.sh).
  date +%s
}

# sshd_apply — the drop-in reaches new sessions once sshd re-reads its
# config. sshd -t first, as ssh.service itself does before every start: a
# drop-in sshd rejects is removed again, because left in place it would keep
# sshd from starting at the next boot and lock the lab out. Then
# try-reload-or-restart ssh.service: on Ubuntu 24.04 ssh.socket only holds
# the listening socket (generated from Port/ListenAddress, which this drop-in
# leaves alone), and ClientAlive* are settings of the sshd that ssh.service
# runs, so a reload (its ExecReload: sshd -t, then SIGHUP) is what applies
# them. A reload keeps established sessions, the push's own included. When
# ssh.service is not running (socket activation, no client yet) there is
# nothing to reload: the next connection starts sshd with the drop-in.
sshd_apply() {
  local out
  if ! out=$(sshd -t 2>&1); then
    rm -f "$SSHD_DROPIN"
    die "sshd -t rejects the ssh config, so ${SSHD_DROPIN#"$ROOT_PREFIX"} was removed again and the stop was not handed over: ${out%%$'\n'*}"
  fi
  systemctl try-reload-or-restart "$SSH_SERVICE" || die "cannot reload $SSH_SERVICE for its drop-in"
}

# idle_window_restart — a push is the user at work, so the idle count goes
# back to 0: the record the next check counts from (and status and up's
# ready screen read) restarts the window. Without it, an up that reattaches
# to a host idle for most of its window opens only brief sessions, which no
# 5-minute check is likely to see, so the host could stop minutes after up
# said ready. A check that races this sees the push's own ssh session and
# resets too. Before the handoff: a record that can't be written dies with
# whatever stop was armed still armed.
idle_window_restart() {
  local conf
  conf=$(cat "$CONF_FILE" 2>/dev/null) || conf=''
  write_file "$IDLE_RECORD" "$(idle_record "$(date +%s)" reset 0 "$(idle_required_of "$(idle_required "$conf")")")" 0644 \
    || die "cannot restart the idle window in ${IDLE_RECORD#"$ROOT_PREFIX"}: the stop was not handed over"
}

# idle_arm — the handoff (R5). Invariant: from launch onward every boot has a
# stop armed. The idle timer is enabled (for every boot from now on) and
# started first; only once it is active is the dead-man timer disabled and
# stopped, and only if user-data installed one. If arming fails, install
# dies and the dead-man timer stays armed; if disarming fails, both are
# armed (the host still stops 2h after boot) and install dies, so up says so.
idle_arm() {
  if ! systemctl enable --now "$IDLE_TIMER" || ! systemctl is-active --quiet "$IDLE_TIMER"; then
    die "cannot arm $IDLE_TIMER: the dead-man timer stays armed, so the host still stops 2h after boot"
  fi
  [[ -f $SYSTEMD_DIR/$DEADMAN_TIMER ]] || return 0
  systemctl disable --now "$DEADMAN_TIMER" \
    || die "$IDLE_TIMER is armed, but $DEADMAN_TIMER could not be disarmed: it still stops the host 2h after boot"
}

cmd_progress_reset() {
  require_root progress-reset
  mkdir -p "$MARKER_DIR"
  : > "$PROGRESS_FILE"
  chmod 0644 "$PROGRESS_FILE"
}

# cmd_progress — the Mac's poll: the progress file, then the unit's state
cmd_progress() { progress_report "$(unit_show)"; }

# progress_report <unit_show text> — the progress file, then the provision
# unit's "unit <ActiveState> <Result>" line
progress_report() {
  [[ ! -f $PROGRESS_FILE ]] || cat "$PROGRESS_FILE"
  printf 'unit %s %s\n' "$(unit_state "$1" "$SERVICE" ActiveState)" "$(unit_state "$1" "$SERVICE" Result)"
}

# unit_property <property> [unit] -> its value (the provision unit by
# default), or unknown
unit_property() {
  local value
  value=$(systemctl show -p "$1" --value "${2:-$SERVICE}" 2>/dev/null) || value=''
  echo "${value:-unknown}"
}

# unit_show -> ActiveState and Result of every STATUS_UNITS unit, from one
# `systemctl show`; nothing when systemctl fails
# shellcheck disable=SC2086  # the list is one word per unit
unit_show() { systemctl show -p ActiveState -p Result $STATUS_UNITS 2>/dev/null || true; }

# unit_state <unit_show text> <unit> <ActiveState|Result> -> its value, or unknown
unit_state() { show_value "$1" "$(unit_place "$2")" "$3"; }

# cmd_status — read-only (the Mac's status relies on it): the progress, then
# one "<key> <value>" line per idle fact (U4) and per guest fact, parsed by
# lib/remote.sh:
#   idle <ActiveState> <Result>             helios-lab-idle.timer's state (active:
#                                           armed), and the idle check's last run
#                                           as systemd saw it
#   idle-run <record> | idle-run none       the last check's record (idle_record)
#   inhibit <deadline> | none | invalid     a keep, as the idle check judges it now
#   deadman <ActiveState>                   the user-data dead-man timer
#   verified no | verified <pin> <sizing>   guest-verified's record
#   pushed <pin> <sizing> | pushed unknown  what host.conf and engvm-lab.sh say now
#   domain <virsh domstate> | absent | unknown
#   create <ActiveState of the create unit>
#   lease <IPv4> | lease none               libnss-libvirt's answer for helios
#   sshd open | sshd closed                 the guest's tcp/22, from the host
#   console <line>                          an unverified guest's latest
#                                           transcript lines, oldest first
# The host holds no key for the guest, so it can only probe it: the Mac's
# smoke check is what verifies it. Every unit fact comes from one
# `systemctl show` (unit_show).
cmd_status() {
  local show domain lease verified=no line
  show=$(unit_show)
  progress_report "$show"
  idle_facts "$show"
  [[ ! -f $GUEST_VERIFIED ]] || verified=$(record_line "$(cat "$GUEST_VERIFIED")")
  echo "verified $verified"
  echo "pushed $(pushed_line)"
  domain=$(domain_state)
  echo "domain $domain"
  echo "create $(unit_state "$show" "$CREATE_UNIT" ActiveState)"
  lease=$(guest_lease)
  echo "lease ${lease:-none}"
  if [[ -n $lease && $domain == running ]] && port22_open "$lease"; then echo 'sshd open'; else echo 'sshd closed'; fi
  [[ $verified == no ]] || return 0
  while IFS= read -r line; do
    [[ -z $line ]] || printf 'console %s\n' "$line"
  done <<< "$(transcript_lines "$TRANSCRIPT_LINES")"
}

# idle_facts <unit_show text> — status's idle lines (cmd_status), from reads only
idle_facts() {
  local now
  now=$(date +%s 2>/dev/null) || now='?'
  echo "idle $(unit_state "$1" "$IDLE_TIMER" ActiveState) $(unit_state "$1" "$IDLE_SERVICE" Result)"
  echo "idle-run $(idle_record_read)"
  echo "inhibit $(inhibit_state "$now" "$(inhibit_read)")"
  echo "deadman $(unit_state "$1" "$DEADMAN_TIMER" ActiveState)"
}

# record_line <record text> -> "<pin> <sizing>"
record_line() { echo "$(record_field "$1" ENGVM_PIN) $(record_field "$1" SIZING)"; }

# pushed_line -> "<pin> <sizing>" as the last push left them, or unknown
pushed_line() {
  local pin sizing
  if pin=$(conf_get "$(cat "$CONF_FILE" 2>/dev/null || true)" ENGVM_PIN) && sizing=$(lab_sizing "$(lab_conf_text)"); then
    echo "$pin $sizing"
  else
    echo unknown
  fi
}

# guest_lease -> the guest's IPv4 from its DHCP lease (libnss-libvirt, which
# also serves the Mac's ProxyJump; the spike resolved it with getent), or
# nothing. getent prints one line per address: the first IPv4 counts.
guest_lease() {
  local ip rest
  while read -r ip rest; do
    [[ ! $ip =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || { echo "$ip"; return 0; }
  done <<< "$(getent hosts "$GUEST_VM" 2>/dev/null || true)"
}

# port22_open <IPv4> — bash's own /dev/tcp, bounded, so no extra package
port22_open() { timeout 2 bash -c "exec 3<>/dev/tcp/$1/22" 2>/dev/null; }

# cmd_guest_verified — the Mac's smoke check passed: the record of what the
# guest was created from becomes guest-verified (written first: from here
# on, provisioning never recreates this guest), the create unit stops, which
# frees the console and leaves the domain running (U7), and the guest
# autostarts with the host from now on.
cmd_guest_verified() {
  require_root guest-verified
  [[ -f $GUEST_BUILT ]] || die "no guest create is recorded ($GUEST_BUILT): nothing to mark verified"
  write_file "$GUEST_VERIFIED" "$(cat "$GUEST_BUILT")" 0644 || die "cannot write $GUEST_VERIFIED"
  create_unit_stop
  virsh_sys autostart "$GUEST_VM" >/dev/null || die "cannot mark $GUEST_VM to autostart"
}

# cmd_guest_abandon — an unverified first boot never passed the smoke check:
# its create unit stops, so the next provision run destroys and recreates the
# guest. Invariant: a verified guest is never abandoned.
cmd_guest_abandon() {
  require_root guest-abandon
  [[ ! -f $GUEST_VERIFIED ]] || die 'the guest is verified: a verified guest is never abandoned or recreated'
  create_unit_stop
}

create_unit_stop() {
  case $(unit_property ActiveState "$CREATE_UNIT") in
    active|activating|reloading) systemctl stop "$CREATE_UNIT" || die "cannot stop $CREATE_UNIT" ;;
  esac
}

# cmd_journal [n|all] — the unit's journal since the current run began (the
# first progress line's epoch); the last n lines, 20 by default
cmd_journal() {
  local n=${1:-20} since
  local -a args=(-u "$SERVICE" -o cat --no-pager)
  [[ $n == all || $n =~ ^[1-9][0-9]{0,4}$ ]] || die 'usage: helios-lab-host journal [<lines>|all]'
  since=$(run_epoch)
  [[ -z $since ]] || args+=(--since "@$since")
  [[ $n == all ]] || args+=(-n "$n")
  journalctl "${args[@]}"
}

# run_epoch -> the epoch of the current run's first progress line, or nothing
run_epoch() {
  local epoch rest
  [[ -f $PROGRESS_FILE ]] || return 0
  read -r epoch rest < "$PROGRESS_FILE" || return 0
  [[ ! $epoch =~ ^[0-9]+$ ]] || echo "$epoch"
}

# --- Idle check and keep -----------------------------------------------------
# cmd_idle_check — helios-lab-idle.service's ExecStart, every 5 min: gather
# the inputs, decide (idle_decision, pure), record the count, act. Fail
# closed: nothing here may end the run before it acts, so errexit is off,
# every input is bounded in time and passed on as "?" when it can't be read,
# and an unreadable input counts as idle. Exits 1 when an input, the record
# or the poweroff failed: systemd marks the run failed, and status (with
# the record's problem) shows it above the state line.
cmd_idle_check() {
  require_root idle-check
  set +e
  local state active now inhibit sessions count required problems decision
  read -r state active now inhibit sessions count required <<< "$(idle_inputs)"
  problems=$(idle_problems "$state" "$active" "$now" "$inhibit" "$sessions" "$count" "$required")
  decision=$(idle_decision "$state" "$active" "$now" "$inhibit" "$sessions" "$count" "$required")
  echo "idle-check: provision $state (age $active), keep $inhibit, sessions $sessions, count $count of $required: $decision${problems:+ (could not use $problems)}"
  idle_conclude "$now" "$decision" "$(idle_next_count "$decision" "$count")" \
    "$(idle_required_of "$required")" "${problems:+could not use $problems}"
}

# idle_inputs -> the seven inputs on one line (idle_problems' order), each a
# single word, "?" for one that could not be read
idle_inputs() {
  local show state
  show=$(bounded systemctl show -p ActiveState -p ActiveEnterTimestampMonotonic "$SERVICE" 2>/dev/null) || show=''
  state=$(conf_get "$show" ActiveState) || state=''
  echo "${state:-?} $(provision_age "${state:-?}" "$show") $(date +%s 2>/dev/null || echo '?')" \
    "$(inhibit_read) $(session_count) $(idle_record_count "$(idle_record_read)")" \
    "$(idle_required "$(cat "$CONF_FILE" 2>/dev/null || true)")"
}

bounded() { timeout "$INPUT_TIMEOUT_S" "$@"; }

# provision_age <ActiveState> <systemctl show text> -> the run's age in
# seconds, - when it is not active, ? when unreadable
provision_age() {
  local enter uptime
  [[ $1 == active ]] || { echo -; return 0; }
  enter=$(conf_get "$2" ActiveEnterTimestampMonotonic) || enter=''
  uptime=$(cat "$UPTIME_FILE" 2>/dev/null) || uptime=''
  active_seconds "$enter" "$uptime" || echo '?'
}

# session_count -> established tcp sessions whose local port is 22 (sshd's
# side, IPv4 and IPv6), or ?
session_count() {
  local out
  out=$(bounded ss -Htn state established '( sport = :22 )' 2>/dev/null) || { echo '?'; return 0; }
  count_lines "$out"
}

# inhibit_read -> keep's deadline as written, none without a keep, ? when unreadable
inhibit_read() {
  local v
  [[ -e $INHIBIT_FILE ]] || { echo none; return 0; }
  v=$(cat "$INHIBIT_FILE" 2>/dev/null) || v=''
  [[ -n $v && $v != *[[:space:]]* ]] || v='?'
  echo "$v"
}

# idle_record_read -> the last check's record (its first line), none on a
# fresh boot, ? when unreadable
idle_record_read() {
  local line=''
  [[ -e $IDLE_RECORD ]] || { echo none; return 0; }
  { IFS= read -r line < "$IDLE_RECORD"; } 2>/dev/null || true
  echo "${line:-?}"
}

# idle_conclude <now> <decision> <next count> <required used> <problem|""> —
# record, then act; returns 1 when anything failed. The record is written
# first: a count it cannot keep escalates an idle check to a poweroff.
idle_conclude() {
  local decision=$2 problem=$5 recorded=yes
  write_file "$IDLE_RECORD" "$(idle_record "$1" "$2" "$3" "$4" "$problem")" 0644 2>/dev/null || recorded=no
  decision=$(idle_escalate "$decision" "$recorded")
  [[ $recorded == yes ]] || problem=${problem:+$problem; }"could not record the idle count, so this check powers off"
  [[ -z $problem ]] || echo "idle-check: $problem" >&2
  if [[ $decision == poweroff ]] && ! idle_poweroff; then
    problem=${problem:+$problem; }'systemctl poweroff failed'
    write_file "$IDLE_RECORD" "$(idle_record "$1" "$decision" "$3" "$4" "$problem")" 0644 2>/dev/null
  fi
  [[ -z $problem ]]
}

# idle_poweroff — a clean poweroff: libvirt-guests shuts the guest down first
# (ON_SHUTDOWN=shutdown; Helios honours ACPI in about 20 s, U7), then the
# host goes down. Its shutdown behaviour is stop (U6), so EC2 stops the
# instance and keeps its disk. Invariant: the idle path only ever stops.
idle_poweroff() {
  echo 'idle-check: idle for the whole window: powering off (EC2 stops the instance)'
  systemctl poweroff
}

# cmd_keep <seconds>|off — keep's deadline, on the host's clock, at most
# KEEP_MAX_S ahead; prints it, or "off". It lives on disk, so it survives a
# stop and start: a keep is a deadline on the wall clock, inert once passed
# (the idle check then counts as usual), and `helios-lab keep off` clears it.
cmd_keep() {
  local until
  require_root keep
  case ${1:-} in
    off) rm -f "$INHIBIT_FILE" || die "cannot remove $INHIBIT_FILE"
         echo off ;;
    *)   until=$(keep_until "$(date +%s)" "${1:-}") || die "usage: $HOST_SELF keep <seconds, 1 to $KEEP_MAX_S> | off"
         write_file "$INHIBIT_FILE" "$until" 0644 || die "cannot write $INHIBIT_FILE"
         echo "$until" ;;
  esac
}

require_root() { (( EUID == 0 )) || die "$1 must run as root"; }

main() {
  set -euo pipefail
  case ${1:-} in
    install)        cmd_install "${2:-}" ;;
    provision)      cmd_provision ;;
    progress-reset) cmd_progress_reset ;;
    progress)       cmd_progress ;;
    journal)        cmd_journal "${2:-}" ;;
    status)         cmd_status ;;
    guest-verified) cmd_guest_verified ;;
    guest-abandon)  cmd_guest_abandon ;;
    idle-check)     cmd_idle_check ;;
    keep)           cmd_keep "${2:-}" ;;
    *)              die "usage: $HOST_SELF install <dir> | provision | progress-reset | progress | journal [<lines>|all] | status | guest-verified | guest-abandon | idle-check | keep <seconds>|off" ;;
  esac
}

# Run only when executed, so the Mac suite can source the pure functions.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
