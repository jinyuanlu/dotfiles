#!/usr/bin/env bash
# sync-gstack — Pull latest gstack skills from GitHub into dotfiles
# Rewrites gstack-specific paths to match the dotfiles layout.
# Usage: sync-gstack [--dry-run] [--ref <branch|tag>]
set -euo pipefail

GSTACK_REPO="https://github.com/garrytan/gstack.git"
SKILLS_DIR="${DOTFILES_DIR:-.}/.claude/skills"
REF="main"
DRY_RUN=false
GSTACK_MARKER="AUTO-GENERATED from SKILL.md.tmpl"

# Skills to sync (gstack dir name → dotfiles dir name)
# Add new skills here when gstack ships them.
SYNC_SKILLS=(
  browse
  careful
  codex
  design-consultation
  design-review
  document-release
  freeze
  guard
  investigate
  office-hours
  plan-ceo-review
  plan-design-review
  plan-eng-review
  qa
  qa-only
  retro
  review
  setup-browser-cookies
  setup-gbrain
  ship
  sync-gbrain
  unfreeze
)

# Top-level gstack bin scripts (live in gstack/bin/, not in any skill dir)
# that the gbrain skills shell out to. Synced into dotfiles skills/bin/
# with the `gstack-` filename prefix stripped, matching the existing
# rewrite convention (e.g. `skills/bin/config` for `gstack-config`).
SYNC_TOP_BINS=(
  gstack-gbrain-detect
  gstack-gbrain-install
  gstack-gbrain-lib.sh
  gstack-gbrain-mcp-verify
  gstack-gbrain-repo-policy
  gstack-gbrain-source-wireup
  gstack-gbrain-supabase-provision
  gstack-gbrain-supabase-verify
  gstack-gbrain-sync.ts
  gstack-memory-ingest.ts
  gstack-brain-sync
  gstack-brain-enqueue
)

# Top-level gstack lib files imported by the SYNC_TOP_BINS TypeScript
# orchestrators. Synced into skills/lib/ with `gstack-` prefix stripped.
SYNC_TOP_LIB=(
  lib/gbrain-sources.ts
  lib/gstack-memory-helpers.ts
)

# Skills deliberately excluded:
#   gstack-upgrade — gstack self-updater; sync-gstack is our upgrade mechanism

usage() {
  echo "Usage: sync-gstack [--dry-run] [--ref <branch|tag>]"
  echo ""
  echo "Options:"
  echo "  --dry-run   Show what would change without writing files"
  echo "  --ref REF   Git ref to sync from (default: main)"
  echo "  --help      Show this help"
  exit 0
}

# Rewrite gstack-specific paths in a synced file to match dotfiles layout.
# Rules are anchored on path-context characters (/, $, ", `, lib/, dirname)
# so they don't touch error-message strings like `echo "gstack-X: failed"`.
#
#   1. SKILL.md preambles: skills/gstack/bin/gstack-{name} → skills/bin/{name}
#      (strips both the parent `gstack/` and the `gstack-` filename prefix)
#   2. Blanket SKILL.md:   skills/gstack/{anything}        → skills/{anything}
#   3. Cross-bin via $SCRIPT_DIR (bash):
#        $SCRIPT_DIR/gstack-{name}  →  $SCRIPT_DIR/{name}
#   4. Cross-bin via dirname (bash source statements):
#        $(dirname "$0")/gstack-X   →  $(dirname "$0")/X
#   5. TS lib imports (sync.ts, memory-ingest.ts):
#        "../lib/gstack-X"          →  "../lib/X"
#   6. TS sibling import (gbrain-sources.ts → memory-helpers):
#        "./gstack-X"               →  "./X"
#   7. TS sibling exec (sync.ts spawning siblings via import.meta.dir):
#        import.meta.dir, "gstack-X" → import.meta.dir, "X"
rewrite_paths() {
  local file="$1"
  sed -i '' \
    -e 's|skills/gstack/bin/gstack-|skills/bin/|g' \
    -e 's|skills/gstack/|skills/|g' \
    -e 's|\$SCRIPT_DIR/gstack-|$SCRIPT_DIR/|g' \
    -e 's|(dirname "\$0")/gstack-|(dirname "$0")/|g' \
    -e 's|"\.\./lib/gstack-|"../lib/|g' \
    -e 's|"\./gstack-|"./|g' \
    -e 's|import\.meta\.dir, "gstack-|import.meta.dir, "|g' \
    "$file"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    --ref) REF="$2"; shift 2 ;;
    --help|-h) usage ;;
    *) echo "Unknown option: $1"; usage ;;
  esac
done

# Create a temp dir for the shallow clone (avoid shadowing system TMPDIR)
SYNC_TMPDIR=$(mktemp -d)
trap 'rm -rf "$SYNC_TMPDIR"' EXIT

echo "Fetching gstack@${REF} ..."
git clone --depth 1 --branch "$REF" --single-branch --quiet "$GSTACK_REPO" "$SYNC_TMPDIR/gstack"

SYNCED_SHA=$(git -C "$SYNC_TMPDIR/gstack" rev-parse HEAD)
echo "  SHA: ${SYNCED_SHA:0:12}"

ADDED=0
UPDATED=0
UNCHANGED=0

for skill in "${SYNC_SKILLS[@]}"; do
  src="$SYNC_TMPDIR/gstack/$skill"
  dst="$SKILLS_DIR/$skill"

  if [[ ! -d "$src" ]]; then
    echo "  SKIP  $skill (not found in gstack@${REF})"
    continue
  fi

  if [[ ! -f "$src/SKILL.md" ]]; then
    echo "  SKIP  $skill (no SKILL.md — run 'bun run build' in gstack first?)"
    continue
  fi

  # Collect files to sync:
  #   - all *.md files at any depth (e.g. SKILL.md, checklist.md, specialists/*.md)
  #   - all files under bin/
  # Code subdirs (src/, setup/, dist/, node_modules/) are intentionally skipped —
  # local forks (e.g. browse/src) own those.
  files_to_sync=()
  while IFS= read -r f; do
    rel="${f#$src/}"
    base=$(basename "$f")
    [[ "$base" == "SKILL.md.tmpl" ]] && continue
    files_to_sync+=("$rel")
  done < <(find "$src" -name '*.md' -type f 2>/dev/null)
  if [[ -d "$src/bin" ]]; then
    for f in "$src/bin/"*; do
      [[ -f "$f" ]] && files_to_sync+=("bin/$(basename "$f")")
    done
  fi

  # Rewrite paths in temp copies of every synced text file (md + bin scripts).
  # Encode "/" as "_" in temp filename to avoid collisions across subdirs.
  for relpath in "${files_to_sync[@]}"; do
    safe=$(echo "$relpath" | tr '/' '_')
    rewritten="$SYNC_TMPDIR/rewritten-$skill-$safe"
    cp "$src/$relpath" "$rewritten"
    rewrite_paths "$rewritten"
  done

  changed=false
  for relpath in "${files_to_sync[@]}"; do
    safe=$(echo "$relpath" | tr '/' '_')
    src_file="$SYNC_TMPDIR/rewritten-$skill-$safe"
    dst_file="$dst/$relpath"

    if [[ ! -f "$dst_file" ]]; then
      changed=true
      if $DRY_RUN; then
        echo "  ADD   $skill/$relpath"
      fi
    elif ! diff -q "$src_file" "$dst_file" > /dev/null 2>&1; then
      changed=true
      if $DRY_RUN; then
        echo "  UPD   $skill/$relpath"
        diff -u "$dst_file" "$src_file" 2>/dev/null | head -30 || true
        echo ""
      fi
    fi
  done

  if $changed; then
    if $DRY_RUN; then
      : # already printed above
    else
      is_new=false
      [[ ! -d "$dst" ]] && is_new=true

      mkdir -p "$dst"
      for relpath in "${files_to_sync[@]}"; do
        dst_file="$dst/$relpath"
        mkdir -p "$(dirname "$dst_file")"
        safe=$(echo "$relpath" | tr '/' '_')
        cp "$SYNC_TMPDIR/rewritten-$skill-$safe" "$dst_file"
        [[ "$relpath" == bin/* ]] && chmod +x "$dst_file"
      done

      if $is_new; then
        echo "  ADD   $skill"
        ADDED=$(( ADDED + 1 ))
      else
        echo "  UPD   $skill"
        UPDATED=$(( UPDATED + 1 ))
      fi
    fi
  else
    UNCHANGED=$(( UNCHANGED + 1 ))
  fi
done

# --- Top-level bin/lib sync (gbrain support files) ---
# These don't live inside any skill dir; they're top-level gstack bins/lib
# that the synced skills shell out to or import from.
sync_top_file() {
  local src_rel="$1" dst_rel="$2" exec_bit="$3"
  local src="$SYNC_TMPDIR/gstack/$src_rel"
  local dst="$SKILLS_DIR/$dst_rel"

  if [[ ! -f "$src" ]]; then
    echo "  SKIP  $dst_rel (source not found in gstack@${REF}: $src_rel)"
    return
  fi

  local rewritten="$SYNC_TMPDIR/rewritten-top-$(echo "$dst_rel" | tr '/' '_')"
  cp "$src" "$rewritten"
  rewrite_paths "$rewritten"

  if [[ ! -f "$dst" ]]; then
    if $DRY_RUN; then
      echo "  ADD   $dst_rel"
    else
      mkdir -p "$(dirname "$dst")"
      cp "$rewritten" "$dst"
      [[ "$exec_bit" == "yes" ]] && chmod +x "$dst"
      echo "  ADD   $dst_rel"
      ADDED=$(( ADDED + 1 ))
    fi
  elif ! diff -q "$rewritten" "$dst" > /dev/null 2>&1; then
    if $DRY_RUN; then
      echo "  UPD   $dst_rel"
    else
      cp "$rewritten" "$dst"
      [[ "$exec_bit" == "yes" ]] && chmod +x "$dst"
      echo "  UPD   $dst_rel"
      UPDATED=$(( UPDATED + 1 ))
    fi
  else
    UNCHANGED=$(( UNCHANGED + 1 ))
  fi
}

# Strip `gstack-` prefix from filename (matches the existing skills/bin/
# rewrite convention). gstack-gbrain-detect → bin/gbrain-detect.
for src_name in "${SYNC_TOP_BINS[@]}"; do
  dst_name="${src_name#gstack-}"
  sync_top_file "bin/$src_name" "bin/$dst_name" yes
done

# lib/ files: same convention, strip `gstack-` from filename.
# Files already named without prefix (e.g. gbrain-sources.ts) pass through.
for src_rel in "${SYNC_TOP_LIB[@]}"; do
  base=$(basename "$src_rel")
  dst_base="${base#gstack-}"
  sync_top_file "$src_rel" "lib/$dst_base" no
done

# --- Stale skill cleanup ---
# Detect gstack-sourced skill dirs that are no longer in SYNC_SKILLS
for dir in "$SKILLS_DIR"/*/; do
  [[ ! -d "$dir" ]] && continue
  skill_name=$(basename "$dir")

  # Skip if in SYNC_SKILLS
  in_list=false
  for s in "${SYNC_SKILLS[@]}"; do
    [[ "$s" == "$skill_name" ]] && { in_list=true; break; }
  done
  $in_list && continue

  # Only act on gstack-sourced skills (never touch local skills)
  if [[ -f "$dir/SKILL.md" ]] && grep -q "$GSTACK_MARKER" "$dir/SKILL.md" 2>/dev/null; then
    if $DRY_RUN; then
      echo "  STALE $skill_name (would be removed)"
    else
      echo "  STALE $skill_name (gstack-sourced, removed from sync list)"
      rm -rf "$dir"
    fi
  fi
done

# --- Post-sync verification ---
if ! $DRY_RUN; then
  # Scan all synced files for residual paths or unrewritten cross-refs.
  # Patterns checked:
  #   - `skills/gstack/`  — old SKILL.md preamble references
  #   - `gstack-gbrain-`, `gstack-memory-`, `gstack-brain-` outside of
  #     comments/docstrings — possible unrewritten cross-bin refs
  residual_file=/tmp/.gstack-residual.$$
  : > "$residual_file"

  while IFS= read -r f; do
    # Skip sync-gstack itself — it contains `skills/gstack/` as the literal
    # rewrite regex it applies to other files.
    [[ "$(basename "$f")" == "sync-gstack" ]] && continue
    [[ -f "$f" ]] && grep -l 'skills/gstack/' "$f" >> "$residual_file" 2>/dev/null || true
  done < <(find "$SKILLS_DIR" \( -name '*.md' -o -path '*/bin/*' -o -path '*/lib/*' \) -type f 2>/dev/null)

  residual=$(sort -u "$residual_file" 2>/dev/null || true)
  rm -f "$residual_file"
  if [[ -n "$residual" ]]; then
    echo ""
    echo "WARNING: Residual gstack/ path references found in:"
    echo "$residual"
    echo "These files may have broken refs. Check rewrite_paths() coverage."
  fi

  # Write sync state
  cat > "$SKILLS_DIR/.gstack-sync-state" <<EOF
sha=$SYNCED_SHA
ref=$REF
date=$(date -u +%Y-%m-%dT%H:%M:%SZ)
skills=$(IFS=,; echo "${SYNC_SKILLS[*]}")
top_bins=$(IFS=,; echo "${SYNC_TOP_BINS[*]}")
top_lib=$(IFS=,; echo "${SYNC_TOP_LIB[*]}")
EOF
fi

echo ""
if $DRY_RUN; then
  echo "Dry run complete. No files written."
else
  echo "Sync complete: $ADDED added, $UPDATED updated, $UNCHANGED unchanged."
  echo "Pinned: gstack@${REF} (${SYNCED_SHA:0:12})"
fi
